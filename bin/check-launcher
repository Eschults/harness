#!/usr/bin/env bash
# Functional check for bin/harness, the launcher: which CLI version it runs,
# that it downloads each version once and reuses it offline, and that the
# v1.3.x fallback never mistakes a launcher for a CLI. Releases are file://
# fixtures and the network is poisoned. No model calls.
set -euo pipefail
cd "$(dirname "$0")/.."

# shellcheck source=bin/lib/check-helpers.sh
source bin/lib/check-helpers.sh
# shellcheck source=bin/harness-cli
source bin/harness-cli

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
poison_network
stub_url_openers "$scratch/stub_bin"

# A scratch copy, since upgrade replaces the launcher it runs from and must never touch this checkout's.
launcher="$scratch/launcher-bin/harness"
mkdir -p "$(dirname "$launcher")"
cp bin/harness "$launcher"

releases="$scratch/releases"
tags_json="$scratch/tags.json"
# v2.0.0 is a newer major, which the v1 launcher must never pick as latest.
printf '[{"name":"v1.3.1"},{"name":"v1.4.0"},{"name":"v1.9.9"},{"name":"v2.0.0"}]' > "$tags_json"

# A CLI stub that reports which version ran, with what HARNESS_RELEASE_SRC and args.
stub_cli() {
  local path=$1 version=$2
  mkdir -p "$(dirname "$path")"
  # shellcheck disable=SC2016 # $HARNESS_RELEASE_SRC and $* expand when the stub runs, not here
  printf '#!/usr/bin/env bash\necho "cli %s src=$HARNESS_RELEASE_SRC args=$*"\n' "$version" > "$path"
}

stub_cli "$releases/v1.4.0/bin/harness-cli" v1.4.0
# v1.3.x shipped the full CLI as bin/harness and has no bin/harness-cli.
stub_cli "$releases/v1.3.1/bin/harness" v1.3.1
# A release whose bin/harness is the launcher and whose bin/harness-cli is missing.
mkdir -p "$releases/v1.5.0/bin"
cp bin/harness "$releases/v1.5.0/bin/harness"
# The latest release is real: this checkout's CLI and harness files, so install runs end to end.
mkdir -p "$releases/v1.9.9/bin"
cp bin/harness-cli "$releases/v1.9.9/bin/harness-cli"
cp bin/harness "$releases/v1.9.9/bin/harness"
for f in "${HARNESS_FILES[@]}"; do
  mkdir -p "$releases/v1.9.9/$(dirname "$f")"
  cp "$f" "$releases/v1.9.9/$f"
done
echo v1.9.9 > "$releases/v1.9.9/.claude/HARNESS_VERSION"

export HARNESS_RAW_BASE="file://$releases" HARNESS_TAGS_URL="file://$tags_json"

make_repo() {
  local dir=$1 pinned=${2:-}
  git init -q "$dir"
  if [ -n "$pinned" ]; then
    mkdir -p "$dir/.claude"
    echo "$pinned" > "$dir/.claude/HARNESS_VERSION"
  fi
}

run_launcher() {
  local dir=$1
  shift
  (cd "$dir" && "$launcher" "$@")
}

# --- a pinned repo runs that exact version, without a tag lookup ---
export HARNESS_HOME="$scratch/home"
make_repo "$scratch/pinned" v1.4.0
if ! output=$(HARNESS_TAGS_URL="file://$scratch/no-such-tags.json" run_launcher "$scratch/pinned" doctor --fire 2>&1); then
  echo "$output" >&2
  fail "expected a repo pinned at v1.4.0 to run the v1.4.0 CLI"
fi
[ "$output" = "cli v1.4.0 src=file://$releases args=doctor --fire" ] || fail "expected the v1.4.0 CLI with the releases base as HARNESS_RELEASE_SRC and the args passed through, got: $output"
[ -x "$HARNESS_HOME/v1.4.0/harness" ] || fail "expected the v1.4.0 CLI to be cached under \$HARNESS_HOME/v1.4.0"
echo "✓ a pinned repo runs its pinned CLI version, pointed at that release, with no tag lookup"

# --- --version and -v print the pinned version without downloading it ---
make_repo "$scratch/version-pinned" v1.3.1
for flag in --version -v; do
  output=$(HARNESS_TAGS_URL="file://$scratch/no-such-tags.json" run_launcher "$scratch/version-pinned" "$flag" 2>&1) || fail "expected $flag to succeed, got: $output"
  [ "$output" = "v1.3.1" ] || fail "expected $flag to print the pinned version, got: $output"
done
[ ! -e "$HARNESS_HOME/v1.3.1" ] || fail "expected --version not to download the CLI"
echo "✓ --version and -v print the pinned version with no download or tag lookup"

# --- the cached version keeps working once its release is unreachable ---
mv "$releases/v1.4.0" "$scratch/v1.4.0-offline"
output=$(run_launcher "$scratch/pinned" doctor 2>&1) || fail "expected the cached v1.4.0 CLI to run offline, got: $output"
echo "$output" | grep -q "^cli v1.4.0 " || fail "expected the cached v1.4.0 CLI, got: $output"
mv "$scratch/v1.4.0-offline" "$releases/v1.4.0"
echo "✓ a downloaded version is reused without fetching it again"

# --- install is a pure cache operation; it never touches a repo ---
install_fresh="$scratch/install-fresh"
make_repo "$install_fresh"
if ! output=$(run_launcher "$install_fresh" install 2>&1); then
  echo "$output" >&2
  fail "expected install to cache the latest CLI"
fi
echo "$output" | grep -qF "Installed 1.9.9 into the harness CLI cache" || fail "expected install to report the version it cached, got: $output"
[ -x "$HARNESS_HOME/v1.9.9/harness" ] || fail "expected install to cache v1.9.9 under \$HARNESS_HOME"
[ ! -e "$install_fresh/.claude" ] || fail "expected install to never write to a repo"
echo "✓ install caches the latest v1 release (not v2.0.0) without touching a repo"

if ! output=$(run_launcher "$install_fresh" install v1.4.0 2>&1); then
  echo "$output" >&2
  fail "expected install to cache an explicit version"
fi
echo "$output" | grep -qF "Installed 1.4.0 into the harness CLI cache" || fail "expected install to report the explicit version it cached, got: $output"
[ -x "$HARNESS_HOME/v1.4.0/harness" ] || fail "expected install to cache v1.4.0 under \$HARNESS_HOME"
echo "✓ install also caches an explicit, bare-versioned release"

if output=$(run_launcher "$install_fresh" install v2.0.0 2>&1); then
  fail "expected install to refuse a version from a different major, got: $output"
fi
echo "$output" | grep -qF "v2.0.0 is not a 1.Y.Z version" || fail "expected a clear cross-major message, got: $output"
echo "✓ install refuses a version from a newer major"

# --- versions lists the cache, highlighting the pinned repo's version ---
output=$(run_launcher "$scratch/pinned" versions 2>&1) || fail "expected versions to succeed, got: $output"
echo "$output" | grep -qxF "* 1.4.0 (current)" || fail "expected versions to mark the pinned repo's cached version as current, got: $output"
echo "$output" | grep -qxF "  1.9.9" || fail "expected versions to list the other cached release, got: $output"
echo "✓ versions marks the pinned repo's cached release as current"

versions_outside="$scratch/versions-outside"
mkdir -p "$versions_outside"
output=$(cd "$versions_outside" && HARNESS_HOME="$scratch/home-no-versions" "$launcher" versions 2>&1) || fail "expected versions with an empty cache to succeed, got: $output"
echo "$output" | grep -qF "No harness CLI versions cached yet" || fail "expected a clear empty-cache message, got: $output"
echo "✓ versions reports clearly when nothing is cached yet"

# --- use runs the latest release in the CLI's major, in either direction ---
make_repo "$scratch/fresh"
if ! output=$(run_launcher "$scratch/fresh" use 2>&1); then
  echo "$output" >&2
  fail "expected use to bootstrap a fresh repo at the latest CLI end to end"
fi
[ "$(cat "$scratch/fresh/.claude/HARNESS_VERSION")" = "v1.9.9" ] || fail "expected use to pull in the latest v1 release, v1.9.9"
echo "✓ use runs the latest v1 release (not v2.0.0) and installs its files"

output=$(run_launcher "$scratch/pinned" use 2>&1 </dev/null) || true
echo "$output" | grep -q "Switching 1.4.0 -> 1.9.9" || fail "expected use in a v1.4.0 repo to run the latest CLI, got: $output"
echo "✓ use runs the latest release, even in a repo pinned older"

# --- use replaces the launcher with the latest release's ---
installed_launcher="$scratch/local-bin/harness"
mkdir -p "$(dirname "$installed_launcher")"
cp bin/harness "$installed_launcher"
printf '\n# check-launcher fixture marker: v1.9.9\n' >> "$releases/v1.9.9/bin/harness"
output=$(cd "$scratch/pinned" && "$installed_launcher" use 2>&1 </dev/null) || true
cmp -s "$installed_launcher" "$releases/v1.9.9/bin/harness" || fail "expected use to replace the launcher with the latest release's, got: $output"
[ -x "$installed_launcher" ] || fail "expected the updated launcher to stay executable"
echo "$output" | grep -q "Updated the harness command" || fail "expected use to report updating the launcher, got: $output"
echo "$output" | grep -q "Switching 1.4.0 -> 1.9.9" || fail "expected the use to carry on after updating the launcher, got: $output"
echo "✓ use replaces the launcher with the latest release's, then carries on"

output=$(cd "$scratch/pinned" && "$installed_launcher" use 2>&1 </dev/null) || true
echo "$output" | grep -q "Updated the harness command" && fail "expected no launcher update when it already matches, got: $output"
echo "✓ use leaves an up-to-date launcher alone"

# A latest release whose bin/harness is a full CLI, not a launcher, must never replace the launcher.
before=$(cat "$installed_launcher")
cp "$releases/v1.3.1/bin/harness" "$releases/v1.9.9/bin/harness"
(cd "$scratch/pinned" && "$installed_launcher" use >/dev/null 2>&1 </dev/null) || true
[ "$(cat "$installed_launcher")" = "$before" ] || fail "expected a non-launcher bin/harness to never replace the launcher"
echo "✓ use never replaces the launcher with something that isn't one"

# --- a repo pinned before the CLI existed runs the latest CLI ---
make_repo "$scratch/pre-cli" v1.2.0
output=$(run_launcher "$scratch/pre-cli" doctor 2>&1) || true
echo "$output" | grep -q "harness is on v1.2.0 but v1.9.9 is the latest release" || fail "expected a pre-CLI pin to run the latest CLI, got: $output"
echo "✓ a repo pinned before v1.3.0 runs the latest CLI"

output=$(run_launcher "$scratch/pre-cli" --version 2>"$scratch/stderr") || fail "expected --version in a pre-CLI repo to succeed, got: $output $(<"$scratch/stderr")"
[ "$output" = "v1.9.9" ] || fail "expected --version to print the CLI that runs, got: $output"
[ "$(<"$scratch/stderr")" = "Repo pinned at v1.2.0; run harness use to update it." ] || fail "expected the older pin and an upgrade hint on stderr, got: $(<"$scratch/stderr")"
echo "✓ --version in a repo pinned before v1.3.0 names the latest CLI and the pin"

# --- the CLI answers --version itself, for launchers older than the flag ---
output=$(cd "$scratch/pinned" && "$HARNESS_HOME/v1.9.9/harness" --version 2>"$scratch/stderr") || fail "expected the CLI to answer --version, got: $output $(<"$scratch/stderr")"
[ "$output" = "v1.9.9" ] || fail "expected the CLI to read its version from its folder, got: $output"
[ "$(<"$scratch/stderr")" = "Repo pinned at v1.4.0; run harness use to update it." ] || fail "expected the older pin and an upgrade hint on stderr, got: $(<"$scratch/stderr")"
output=$(cd "$scratch/fresh" && "$HARNESS_HOME/v1.9.9/harness" -v 2>&1) || fail "expected the CLI to answer -v, got: $output"
[ "$output" = "v1.9.9" ] || fail "expected no pin note when the pin matches, got: $output"
if output=$(bin/harness-cli --version 2>&1); then
  fail "expected a checkout's CLI to fail --version, got: $output"
fi
echo "$output" | grep -q "Not a downloaded release" || fail "expected a checkout's CLI to say it isn't a release, got: $output"
echo "✓ the CLI answers --version and -v from its own folder, for launchers that pass the flag through"

# --- the v1.3.x fallback ---
make_repo "$scratch/v131" v1.3.1
output=$(run_launcher "$scratch/v131" doctor 2>&1) || fail "expected a v1.3.1 pin to fall back to that release's bin/harness, got: $output"
echo "$output" | grep -q "^cli v1.3.1 " || fail "expected the v1.3.1 CLI from bin/harness, got: $output"
echo "✓ a v1.3.x release's bin/harness is used as its CLI"

make_repo "$scratch/v150" v1.5.0
if output=$(run_launcher "$scratch/v150" doctor 2>&1); then
  fail "expected a release with only the launcher at bin/harness to fail, got: $output"
fi
echo "$output" | grep -q "Could not download the harness CLI v1.5.0" || fail "expected a clear download error, got: $output"
[ ! -e "$HARNESS_HOME/v1.5.0/harness" ] || fail "expected the launcher never to be cached as a CLI"
echo "✓ the fallback never caches a launcher as a CLI, so it can't run itself in a loop"

# --- bad pins ---
make_repo "$scratch/missing-release" v1.7.0
if output=$(run_launcher "$scratch/missing-release" doctor 2>&1); then
  fail "expected a pin with no such release to fail"
fi
echo "$output" | grep -q "Could not download the harness CLI v1.7.0" || fail "expected a clear download error, got: $output"
[ ! -e "$HARNESS_HOME/v1.7.0/harness.download" ] || fail "expected a failed download to leave no partial file"
echo "✓ a pin with no such release fails clearly and leaves nothing behind"

make_repo "$scratch/garbage-pin" "../../etc"
if output=$(run_launcher "$scratch/garbage-pin" doctor 2>&1); then
  fail "expected a non-vX.Y.Z pin to fail"
fi
echo "$output" | grep -q "not a vX.Y.Z release" || fail "expected a clear error for a non-vX.Y.Z pin, got: $output"
echo "✓ a non-vX.Y.Z pin fails before it can become a path"

# --- outside a repo ---
export HARNESS_HOME="$scratch/home-outside"
mkdir -p "$scratch/outside"
stub_cli "$HARNESS_HOME/v1.4.0/harness" v1.4.0
chmod +x "$HARNESS_HOME/v1.4.0/harness"
output=$(HARNESS_TAGS_URL="file://$scratch/no-such-tags.json" run_launcher "$scratch/outside" help 2>&1) || fail "expected help outside a repo to use a cached CLI, got: $output"
echo "$output" | grep -q "^cli v1.4.0 " || fail "expected the newest cached CLI outside a repo, got: $output"
echo "✓ outside a repo, the newest downloaded CLI runs with no tag lookup"
output=$(HARNESS_TAGS_URL="file://$scratch/no-such-tags.json" run_launcher "$scratch/outside" --version 2>&1) || fail "expected --version outside a repo to succeed, got: $output"
[ "$output" = "v1.4.0" ] || fail "expected --version outside a repo to print the newest cached version, got: $output"
echo "✓ --version outside a repo prints the newest downloaded version with no tag lookup"

export HARNESS_HOME="$scratch/home-empty"
output=$(run_launcher "$scratch/outside" help 2>&1) || fail "expected help outside a repo with nothing cached to download the latest CLI, got: $output"
echo "$output" | grep -q "Usage: harness <command>" || fail "expected the latest CLI's usage, got: $output"
echo "✓ outside a repo with nothing downloaded, the latest CLI runs"

export HARNESS_HOME="$scratch/home-empty-version"
output=$(run_launcher "$scratch/outside" --version 2>&1) || fail "expected --version outside a repo with nothing cached to succeed, got: $output"
[ "$output" = "v1.9.9" ] || fail "expected --version outside a repo with nothing cached to print the latest release, got: $output"
[ ! -e "$HARNESS_HOME/v1.9.9" ] || fail "expected --version not to download the CLI"
echo "✓ --version outside a repo with nothing downloaded prints the latest release without downloading it"

echo
echo "launcher check: all passed"
