#!/usr/bin/env python3
"""Zero-cost regression checks on this repo's own rules text and tooling.

No model calls: most checks assert a load-bearing sentence is still present
in .claude/harness-rules.md, CLAUDE.md, .claude/prompts/issue-to-pr.md, or
.claude/prompts/next-to-build.md, catching accidental deletion or rewording
of a rule during an edit to these files. One check instead asserts that
README.md, bin/harness-install, and bin/harness-upgrade all pin the same
major release tag, catching a stale reference left behind after bin/release
cuts a new major.
"""
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
HARNESS_RULES = (ROOT / ".claude" / "harness-rules.md").read_text()
CLAUDE_MD = (ROOT / "CLAUDE.md").read_text()
ISSUE_TO_PR = (ROOT / ".claude" / "prompts" / "issue-to-pr.md").read_text()
NEXT_TO_BUILD = (ROOT / ".claude" / "prompts" / "next-to-build.md").read_text()
README = (ROOT / "README.md").read_text()
BIN_INSTALL = (ROOT / "bin" / "harness-install").read_text()
BIN_UPGRADE = (ROOT / "bin" / "harness-upgrade").read_text()


def _pinned_major(text: str) -> str | None:
    match = re.search(r"raw\.githubusercontent\.com/Eschults/harness/(v\d+)\b", text)
    return match.group(1) if match else None


README_MAJOR = _pinned_major(README)
BIN_INSTALL_MAJOR = _pinned_major(BIN_INSTALL)
BIN_UPGRADE_MAJOR = _pinned_major(BIN_UPGRADE)

CHECKS = [
    (
        "stop-on-auth-pii",
        "auth, payments, permissions, or PII handling" in HARNESS_RULES,
        "harness-rules.md should still list auth/payments/permissions/PII under 'When to stop'",
    ),
    (
        "never-edit-own-rules",
        "Never edit rules that would alter your behaviour during this run or the next ones." in HARNESS_RULES,
        "harness-rules.md should still ban self-editing rules mid-run",
    ),
    (
        "installed-repos-dont-edit-this-file",
        "In a repository that installed the harness, do not edit this file." in HARNESS_RULES,
        "harness-rules.md should still tell installed repos not to hand-edit it and to use CLAUDE.md instead",
    ),
    (
        "pr-title-format",
        "Title format: `Fix: <summary>` or `Feat: <summary>`." in HARNESS_RULES,
        "harness-rules.md should still pin the PR title format",
    ),
    (
        "concision-bullets-one-thing",
        "PR descriptions, review comments, and in-session explanations use bullet points, and each bullet says one thing." in HARNESS_RULES,
        "harness-rules.md should still require bullet points, one point per bullet, for PR descriptions/comments/explanations",
    ),
    (
        "concision-fewest-words",
        "State what changed and why in the fewest words that stay accurate." in HARNESS_RULES,
        "harness-rules.md should still require the fewest words that stay accurate, not just bullet formatting",
    ),
    (
        "no-suite-must-say-so",
        "If the repository has no test suite, say so in the PR description rather than inventing one or skipping the point silently." in HARNESS_RULES,
        "harness-rules.md should still require calling out a missing test suite instead of inventing or skipping it",
    ),
    (
        "this-repo-test-suite-is-bin-ci",
        "The test suite is `bin/ci`" in CLAUDE_MD,
        "CLAUDE.md should still point to bin/ci as this repo's test suite",
    ),
    (
        "remove-claude-label-as-last-action",
        "Remove the `claude` label as your last action." in ISSUE_TO_PR,
        "issue-to-pr.md should still require removing the claude label as the last action",
    ),
    (
        "recap-review-no-approve-no-request-changes",
        "Never approve, since you cannot be the approval gate, and never request changes, since you already pushed every fix you were going to make."
        in ISSUE_TO_PR,
        "issue-to-pr.md should still ban approving or requesting changes on the self-review",
    ),
    (
        "findings-on-pr-never-in-diff",
        "Findings belong on the pull request, never in the diff." in ISSUE_TO_PR,
        "issue-to-pr.md should still require findings to live on the PR, not in the diff",
    ),
    (
        "next-to-build-files-with-claude-label",
        'Create it with the `claude` label, to let the "Issue to PR" routine take over' in NEXT_TO_BUILD,
        "next-to-build.md should still file the new issue with the claude label",
    ),
    (
        "pinned-major-consistent",
        None not in (README_MAJOR, BIN_INSTALL_MAJOR, BIN_UPGRADE_MAJOR)
        and README_MAJOR == BIN_INSTALL_MAJOR == BIN_UPGRADE_MAJOR,
        f"README.md ({README_MAJOR}), bin/harness-install ({BIN_INSTALL_MAJOR}), and bin/harness-upgrade ({BIN_UPGRADE_MAJOR}) "
        "should all pin the same harness major release tag",
    ),
]


def main() -> int:
    failed = False
    for name, ok, message in CHECKS:
        mark = "✓" if ok else "✗"
        print(f"{mark} {name}" + ("" if ok else f": {message}"))
        failed = failed or not ok
    print(f"\n{len(CHECKS)} check(s), {'FAILED' if failed else 'all passed'}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
