#!/usr/bin/env python3
"""Zero-cost regression checks on this repo's own rules text and tooling.

No model calls: most checks assert a load-bearing sentence is still present
in .claude/harness-rules.md, CLAUDE.md, .claude/prompts/issue-to-pr.md, or
.claude/prompts/next-to-build.md, catching accidental deletion or rewording
of a rule during an edit to these files. One check instead asserts that
README.md, bin/harness-install, and bin/harness-upgrade all pin the same
major release tag, catching a stale reference left behind after bin/release
cuts a new major. Another set of checks extracts every relative link (and
the "Install is N files" count) out of README.md and verifies them against
the working tree, catching link rot and a stale file count left behind by a
rename or a file added to HARNESS_FILES. A further check scans bin/ and
bin/lib/ for every bash/sh script (by shebang or .sh extension) and fails,
naming it, if it is missing from the shellcheck list in bin/ci, catching a
new bin/ script nobody remembered to add to that list; a self-test proves
that check actually detects a missing script, in a scratch tree, before
trusting its result against the real repo. No network calls: absolute
http(s) links are left alone.
"""
import pathlib
import re
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
HARNESS_RULES = (ROOT / ".claude" / "harness-rules.md").read_text()
CLAUDE_MD = (ROOT / "CLAUDE.md").read_text()
ISSUE_TO_PR = (ROOT / ".claude" / "prompts" / "issue-to-pr.md").read_text()
NEXT_TO_BUILD = (ROOT / ".claude" / "prompts" / "next-to-build.md").read_text()
README = (ROOT / "README.md").read_text()
BIN_INSTALL = (ROOT / "bin" / "harness-install").read_text()
BIN_UPGRADE = (ROOT / "bin" / "harness-upgrade").read_text()
SETTINGS_JSON = (ROOT / ".claude" / "settings.json").read_text()
FETCH_FILES = (ROOT / "bin" / "lib" / "fetch-files.sh").read_text()
CI = (ROOT / "bin" / "ci").read_text()


def _pinned_major(text: str) -> str | None:
    match = re.search(r"raw\.githubusercontent\.com/Eschults/harness/(v\d+)\b", text)
    return match.group(1) if match else None


README_MAJOR = _pinned_major(README)
BIN_INSTALL_MAJOR = _pinned_major(BIN_INSTALL)
BIN_UPGRADE_MAJOR = _pinned_major(BIN_UPGRADE)

_ABSOLUTE_LINK = re.compile(r"^[a-zA-Z][a-zA-Z0-9+.-]*:")
_NUMBER_WORDS = {
    "zero": 0, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5,
    "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10,
    "eleven": 11, "twelve": 12,
}


def _strip_fenced_code_blocks(text: str) -> str:
    """Drop ```...``` blocks so example headings/links inside them (e.g. the
    sample harness-rules.md snippet in README.md) aren't mistaken for real ones."""
    return re.sub(r"```.*?```", "", text, flags=re.DOTALL)


def _heading_anchors(text: str) -> set[str]:
    """GitHub-style heading slugs: lowercase, drop punctuation, spaces to hyphens."""
    anchors = set()
    for heading in re.findall(r"(?m)^#{1,6}\s+(.+?)\s*$", _strip_fenced_code_blocks(text)):
        slug = re.sub(r"[^\w\s-]", "", heading.lower())
        anchors.add(re.sub(r"\s+", "-", slug.strip()))
    return anchors


def _readme_relative_links() -> list[str]:
    text = _strip_fenced_code_blocks(README)
    links = set()
    links.update(re.findall(r"\]\(([^)]+)\)", text))
    links.update(re.findall(r'(?:src|srcset)="([^"]+)"', text))
    return sorted(link for link in links if not _ABSOLUTE_LINK.match(link))


def _readme_link_checks() -> list[tuple[str, bool, str]]:
    checks = []
    for link in _readme_relative_links():
        path, _, anchor = link.partition("#")
        if not path:
            ok = not anchor or anchor in _heading_anchors(README)
            checks.append((
                f"readme-link:#{anchor}",
                ok,
                f"README.md links to #{anchor}, but README.md has no heading matching it",
            ))
            continue
        target = ROOT / path
        if not target.is_file():
            checks.append((
                f"readme-link:{link}",
                False,
                f"README.md links to {path!r}, which does not exist in the working tree",
            ))
            continue
        if anchor:
            ok = anchor in _heading_anchors(target.read_text())
            checks.append((
                f"readme-link:{link}",
                ok,
                f"README.md links to {path}#{anchor}, but {path} has no heading matching #{anchor}",
            ))
        else:
            checks.append((f"readme-link:{link}", True, ""))
    return checks


def _harness_files() -> list[str]:
    match = re.search(r"HARNESS_FILES=\((.*?)\)", FETCH_FILES, re.DOTALL)
    return re.findall(r'"([^"]+)"', match.group(1)) if match else []


def _readme_install_file_count_check() -> tuple[str, bool, str]:
    match = re.search(r"Install is (\w+) files", README)
    word = match.group(1).lower() if match else None
    readme_count = _NUMBER_WORDS.get(word) if word else None
    expected_count = len(_harness_files()) + 4  # bin/harness-install, bin/harness-upgrade, bin/lib/fetch-files.sh, bin/lib/version-check.sh
    ok = readme_count is not None and readme_count == expected_count
    return (
        "readme-install-file-count",
        ok,
        f"README.md says 'Install is {word} files' ({readme_count}), but HARNESS_FILES plus "
        f"bin/harness-install, bin/harness-upgrade, bin/lib/fetch-files.sh, and bin/lib/version-check.sh "
        f"total {expected_count} file(s)",
    )

def _shellcheck_list(ci_text: str) -> list[str]:
    """The file list in bin/ci's `for f in ...; do` shellcheck loop."""
    match = re.search(r"for f in (.*?); do", ci_text, re.DOTALL)
    return match.group(1).split() if match else []


def _shebang_interpreter(first_line: str) -> str | None:
    if not first_line.startswith("#!"):
        return None
    parts = first_line[2:].split()
    if not parts:
        return None
    exe = pathlib.PurePosixPath(parts[0]).name
    if exe == "env" and len(parts) > 1:
        exe = parts[1]
    return exe


def _is_shell_script(path: pathlib.Path) -> bool:
    if path.suffix == ".sh":
        return True
    try:
        with path.open(encoding="utf-8", errors="ignore") as fh:
            first_line = fh.readline()
    except OSError:
        return False
    return _shebang_interpreter(first_line) in ("bash", "sh")


def _bin_shell_scripts(root: pathlib.Path) -> list[str]:
    """Every bash/sh script under bin/ and bin/lib/, by shebang or .sh extension."""
    scripts = []
    for base in ("bin", "bin/lib"):
        directory = root / base
        if not directory.is_dir():
            continue
        for path in sorted(directory.iterdir()):
            if path.is_file() and _is_shell_script(path):
                scripts.append(f"{base}/{path.name}")
    return scripts


def _missing_from_shellcheck_list(root: pathlib.Path, ci_text: str) -> list[str]:
    listed = set(_shellcheck_list(ci_text))
    return [s for s in _bin_shell_scripts(root) if s not in listed]


def _shellcheck_coverage_checks() -> list[tuple[str, bool, str]]:
    missing = _missing_from_shellcheck_list(ROOT, CI)
    if not missing:
        return [("shellcheck-coverage", True, "")]
    return [
        (
            f"shellcheck-coverage:{script}",
            False,
            f"{script} looks like a shell script (shebang or .sh extension) but is missing from the "
            "shellcheck list in bin/ci",
        )
        for script in missing
    ]


def _shellcheck_coverage_self_test() -> tuple[str, bool, str]:
    """Proves _missing_from_shellcheck_list() actually detects an uncovered script,
    rather than vacuously passing, by adding then removing one in a scratch tree."""
    name = "shellcheck-coverage-self-test"
    with tempfile.TemporaryDirectory() as tmp:
        root = pathlib.Path(tmp)
        (root / "bin" / "lib").mkdir(parents=True)
        (root / "bin" / "covered").write_text("#!/usr/bin/env bash\necho covered\n")
        ci_text = "for f in bin/covered; do\n"

        if _missing_from_shellcheck_list(root, ci_text):
            return (name, False, "detection flagged bin/covered, which is on the shellcheck list")

        # Two strays: one caught only by its .sh extension, one only by its shebang
        # (like every real top-level bin/ script), so a regression in either
        # detection path makes this test fail.
        stray_sh = root / "bin" / "stray-check.sh"
        stray_sh.write_text("#!/usr/bin/env bash\necho stray\n")
        stray_shebang = root / "bin" / "stray-check"
        stray_shebang.write_text("#!/usr/bin/env bash\necho stray\n")
        missing = _missing_from_shellcheck_list(root, ci_text)
        expected = ["bin/stray-check", "bin/stray-check.sh"]
        if missing != expected:
            return (name, False, f"expected detection to fail, naming {expected}; got {missing}")

        stray_sh.unlink()
        stray_shebang.unlink()
        missing = _missing_from_shellcheck_list(root, ci_text)
        if missing:
            return (name, False, f"expected no missing scripts after removing the stray ones; got {missing}")

        return (name, True, "")


CHECKS = [
    (
        "stop-on-auth-pii",
        "auth, payments, permissions, or PII handling" in HARNESS_RULES,
        "harness-rules.md should still list auth/payments/permissions/PII under 'When to stop'",
    ),
    (
        "never-edit-own-rules",
        "Never edit rules that would alter your behaviour during this run or the next ones." in HARNESS_RULES,
        "harness-rules.md should still ban self-editing rules mid-run",
    ),
    (
        "installed-repos-dont-edit-this-file",
        "In a repository that installed the harness, do not edit this file." in HARNESS_RULES,
        "harness-rules.md should still tell installed repos not to hand-edit it and to use CLAUDE.md instead",
    ),
    (
        "pr-title-format",
        "Title format: `Fix: <summary>` or `Feat: <summary>`." in HARNESS_RULES,
        "harness-rules.md should still pin the PR title format",
    ),
    (
        "concision-bullets-one-thing",
        "PR descriptions, review comments, and in-session explanations use bullet points, and each bullet says one thing." in HARNESS_RULES,
        "harness-rules.md should still require bullet points, one point per bullet, for PR descriptions/comments/explanations",
    ),
    (
        "concision-fewest-words",
        "State what changed and why in the fewest words that stay accurate." in HARNESS_RULES,
        "harness-rules.md should still require the fewest words that stay accurate, not just bullet formatting",
    ),
    (
        "no-suite-must-say-so",
        "If the repository has no test suite, say so in the PR description rather than inventing one or skipping the point silently." in HARNESS_RULES,
        "harness-rules.md should still require calling out a missing test suite instead of inventing or skipping it",
    ),
    (
        "this-repo-test-suite-is-bin-ci",
        "The test suite is `bin/ci`" in CLAUDE_MD,
        "CLAUDE.md should still point to bin/ci as this repo's test suite",
    ),
    (
        "remove-claude-label-as-last-action",
        "Remove the `claude` label as your last action." in ISSUE_TO_PR,
        "issue-to-pr.md should still require removing the claude label as the last action",
    ),
    (
        "recap-review-no-approve-no-request-changes",
        "Never approve, since you cannot be the approval gate, and never request changes, since you already pushed every fix you were going to make."
        in ISSUE_TO_PR,
        "issue-to-pr.md should still ban approving or requesting changes on the self-review",
    ),
    (
        "findings-on-pr-never-in-diff",
        "Findings belong on the pull request, never in the diff." in ISSUE_TO_PR,
        "issue-to-pr.md should still require findings to live on the PR, not in the diff",
    ),
    (
        "next-to-build-files-with-claude-label",
        'Create it with the `claude` label, to let the "Issue to PR" routine take over' in NEXT_TO_BUILD,
        "next-to-build.md should still file the new issue with the claude label",
    ),
    (
        "next-to-build-skip-when-work-open",
        "If either list is non-empty, file nothing and end the run" in NEXT_TO_BUILD,
        "next-to-build.md should still skip filing when a claude-labeled issue or claude/ branch PR is already open",
    ),
    (
        "next-to-build-report-skip-reason",
        "If you skipped the run because earlier work is still open, name the issue or PR that caused it." in NEXT_TO_BUILD,
        "next-to-build.md should still require naming the issue or PR that caused a skipped run",
    ),
    (
        "sessionstart-installs-shellcheck",
        "apt-get install" in SETTINGS_JSON and "shellcheck" in SETTINGS_JSON,
        ".claude/settings.json should still have a SessionStart hook installing shellcheck when missing",
    ),
    (
        "pinned-major-consistent",
        None not in (README_MAJOR, BIN_INSTALL_MAJOR, BIN_UPGRADE_MAJOR)
        and README_MAJOR == BIN_INSTALL_MAJOR == BIN_UPGRADE_MAJOR,
        f"README.md ({README_MAJOR}), bin/harness-install ({BIN_INSTALL_MAJOR}), and bin/harness-upgrade ({BIN_UPGRADE_MAJOR}) "
        "should all pin the same harness major release tag",
    ),
]
CHECKS.extend(_readme_link_checks())
CHECKS.append(_readme_install_file_count_check())
CHECKS.append(_shellcheck_coverage_self_test())
CHECKS.extend(_shellcheck_coverage_checks())


def main() -> int:
    failed = False
    for name, ok, message in CHECKS:
        mark = "✓" if ok else "✗"
        print(f"{mark} {name}" + ("" if ok else f": {message}"))
        failed = failed or not ok
    print(f"\n{len(CHECKS)} check(s), {'FAILED' if failed else 'all passed'}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
