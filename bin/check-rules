    (
        "pinned-major-consistent",
        None not in (README_MAJOR, INSTALL_SH_MAJOR, BIN_HARNESS_MAJOR, BIN_HARNESS_CLI_MAJOR, BIN_UPGRADE_MAJOR)
        and README_MAJOR == INSTALL_SH_MAJOR == BIN_HARNESS_MAJOR == BIN_HARNESS_CLI_MAJOR == BIN_UPGRADE_MAJOR,
        f"README.md ({README_MAJOR}), install.sh ({INSTALL_SH_MAJOR}), bin/harness ({BIN_HARNESS_MAJOR}), bin/harness-cli ({BIN_HARNESS_CLI_MAJOR}), "
