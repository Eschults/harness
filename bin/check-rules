#!/usr/bin/env python3
"""Zero-cost regression checks on this repo's own rules text and tooling.

No model calls: most checks assert a load-bearing sentence is still present
in .claude/harness-rules.md, CLAUDE.md, .claude/prompts/issue-to-pr.md, or
.claude/prompts/next-to-build.md, catching accidental deletion or rewording
of a rule during an edit to these files. One check instead asserts that
README.md, install.sh, bin/harness, bin/harness-cli, and the legacy bin/harness-upgrade all pin the same
major release tag, catching a stale reference left behind after bin/release
cuts a new major, and another that the legacy bin/lib/fetch-files.sh lists
the same HARNESS_FILES as bin/harness-cli. Another set of checks extracts every relative link (and
the "N files, two routines" count) out of README.md and verifies them against
the working tree, catching link rot and a stale file count left behind by a
rename or a file added to HARNESS_FILES. Another check fails when a .claude/harness-rules.md section has
changed since its hand-written README.md Guardrails summary was last reviewed (bin/sync-readme). Another
check extracts the two routine instructions blocks pasted into README.md steps 2 and 5 and fails if either
names a .claude/prompts/*.md path that does not exist, drops the instruction to read CLAUDE.md, or (for the
"Issue to PR" block) names a payload tag that does not match the one in .claude/prompts/issue-to-pr.md, or
if README.md is missing one of the two blocks. A further check scans bin/ and
bin/lib/ for every bash/sh script (by shebang or .sh extension) and fails,
naming it, if it is missing from the shellcheck list in bin/ci, catching a
new bin/ script nobody remembered to add to that list; a self-test proves
that check actually detects a missing script, in a scratch tree, before
trusting its result against the real repo. No network calls: absolute
http(s) links are left alone.
"""
import pathlib
import re
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "lib"))
from readme_guardrails import heading_anchor, guardrails_problems, strip_fenced_code_blocks as _strip_fenced_code_blocks  # noqa: E402

ROOT = pathlib.Path(__file__).resolve().parent.parent
HARNESS_RULES = (ROOT / ".claude" / "harness-rules.md").read_text()
CLAUDE_MD = (ROOT / "CLAUDE.md").read_text()
ISSUE_TO_PR = (ROOT / ".claude" / "prompts" / "issue-to-pr.md").read_text()
NEXT_TO_BUILD = (ROOT / ".claude" / "prompts" / "next-to-build.md").read_text()
README = (ROOT / "README.md").read_text()
INSTALL_SH = (ROOT / "install.sh").read_text()
BIN_HARNESS = (ROOT / "bin" / "harness").read_text()
BIN_HARNESS_CLI = (ROOT / "bin" / "harness-cli").read_text()
BIN_UPGRADE = (ROOT / "bin" / "harness-upgrade").read_text()
SETTINGS_JSON = (ROOT / ".claude" / "settings.json").read_text()
LEGACY_FETCH_FILES = (ROOT / "bin" / "lib" / "fetch-files.sh").read_text()
CI = (ROOT / "bin" / "ci").read_text()


def _pinned_major(text: str) -> str | None:
    match = re.search(r"raw\.githubusercontent\.com/Eschults/harness/(v\d+)\b", text)
    return match.group(1) if match else None


README_MAJOR = _pinned_major(README)
INSTALL_SH_MAJOR = _pinned_major(INSTALL_SH)
BIN_HARNESS_MAJOR = _pinned_major(BIN_HARNESS)
BIN_HARNESS_CLI_MAJOR = _pinned_major(BIN_HARNESS_CLI)
BIN_UPGRADE_MAJOR = _pinned_major(BIN_UPGRADE)

_ABSOLUTE_LINK = re.compile(r"^[a-zA-Z][a-zA-Z0-9+.-]*:")
_NUMBER_WORDS = {
    "zero": 0, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5,
    "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10,
    "eleven": 11, "twelve": 12,
}


def _heading_anchors(text: str) -> set[str]:
    """GitHub-style heading slugs: lowercase, drop punctuation, spaces to hyphens."""
    return {heading_anchor(heading) for heading in re.findall(r"(?m)^#{1,6}\s+(.+?)\s*$", _strip_fenced_code_blocks(text))}


def _readme_relative_links() -> list[str]:
    text = _strip_fenced_code_blocks(README)
    links = set()
    links.update(re.findall(r"\]\(([^)]+)\)", text))
    links.update(re.findall(r'(?:src|srcset)="([^"]+)"', text))
    return sorted(link for link in links if not _ABSOLUTE_LINK.match(link))


def _readme_link_checks() -> list[tuple[str, bool, str]]:
    checks = []
    for link in _readme_relative_links():
        path, _, anchor = link.partition("#")
        if not path:
            ok = not anchor or anchor in _heading_anchors(README)
            checks.append((
                f"readme-link:#{anchor}",
                ok,
                f"README.md links to #{anchor}, but README.md has no heading matching it",
            ))
            continue
        target = ROOT / path
        if not target.is_file():
            checks.append((
                f"readme-link:{link}",
                False,
                f"README.md links to {path!r}, which does not exist in the working tree",
            ))
            continue
        if anchor:
            ok = anchor in _heading_anchors(target.read_text())
            checks.append((
                f"readme-link:{link}",
                ok,
                f"README.md links to {path}#{anchor}, but {path} has no heading matching #{anchor}",
            ))
        else:
            checks.append((f"readme-link:{link}", True, ""))
    return checks


def _harness_files(script_text: str) -> list[str]:
    match = re.search(r"HARNESS_FILES=\((.*?)\)", script_text, re.DOTALL)
    return re.findall(r'"([^"]+)"', match.group(1)) if match else []


HARNESS_FILES = _harness_files(BIN_HARNESS_CLI)


def _readme_install_file_count_check() -> tuple[str, bool, str]:
    match = re.search(r"(\w+) files, two routines", README)
    word = match.group(1).lower() if match else None
    readme_count = _NUMBER_WORDS.get(word) if word else None
    expected_count = len(HARNESS_FILES)
    ok = readme_count is not None and readme_count == expected_count
    return (
        "readme-install-file-count",
        ok,
        f"README.md says '{word} files, two routines' ({readme_count}), but bin/harness-cli's HARNESS_FILES "
        f"lists {expected_count} file(s)",
    )

def _readme_guardrails_check() -> tuple[str, bool, str]:
    try:
        problems = guardrails_problems(README, HARNESS_RULES)
    except ValueError as error:
        problems = [str(error)]
    return ("readme-guardrails-in-sync", not problems, "; ".join(problems))

def _cli_readme_anchor_checks() -> list[tuple[str, bool, str]]:
    """Every $HARNESS_README#anchor the CLI prints must match a README.md heading."""
    anchors = sorted(set(re.findall(r"\$HARNESS_README#([\w-]+)", BIN_HARNESS_CLI)))
    if not anchors:
        return [("cli-readme-anchors", False, "bin/harness-cli prints no $HARNESS_README#anchor links; expected at least #setup")]
    return [
        (
            f"cli-readme-anchor:#{anchor}",
            anchor in _heading_anchors(README),
            f"bin/harness-cli links to README.md#{anchor}, but README.md has no heading matching it",
        )
        for anchor in anchors
    ]


def _shellcheck_list(ci_text: str) -> list[str]:
    """The file list in bin/ci's `for f in ...; do` shellcheck loop."""
    match = re.search(r"for f in (.*?); do", ci_text, re.DOTALL)
    return match.group(1).split() if match else []


def _shebang_interpreter(first_line: str) -> str | None:
    if not first_line.startswith("#!"):
        return None
    parts = first_line[2:].split()
    if not parts:
        return None
    exe = pathlib.PurePosixPath(parts[0]).name
    if exe == "env" and len(parts) > 1:
        exe = parts[1]
    return exe


def _is_shell_script(path: pathlib.Path) -> bool:
    if path.suffix == ".sh":
        return True
    try:
        with path.open(encoding="utf-8", errors="ignore") as fh:
            first_line = fh.readline()
    except OSError:
        return False
    return _shebang_interpreter(first_line) in ("bash", "sh")


def _bin_shell_scripts(root: pathlib.Path) -> list[str]:
    """Every bash/sh script under bin/ and bin/lib/, by shebang or .sh extension."""
    scripts = []
    for base in ("bin", "bin/lib"):
        directory = root / base
        if not directory.is_dir():
            continue
        for path in sorted(directory.iterdir()):
            if path.is_file() and _is_shell_script(path):
                scripts.append(f"{base}/{path.name}")
    return scripts


def _missing_from_shellcheck_list(root: pathlib.Path, ci_text: str) -> list[str]:
    listed = set(_shellcheck_list(ci_text))
    return [s for s in _bin_shell_scripts(root) if s not in listed]


def _shellcheck_coverage_checks() -> list[tuple[str, bool, str]]:
    missing = _missing_from_shellcheck_list(ROOT, CI)
    if not missing:
        return [("shellcheck-coverage", True, "")]
    return [
        (
            f"shellcheck-coverage:{script}",
            False,
            f"{script} looks like a shell script (shebang or .sh extension) but is missing from the "
            "shellcheck list in bin/ci",
        )
        for script in missing
    ]


def _shellcheck_coverage_self_test() -> tuple[str, bool, str]:
    """Proves _missing_from_shellcheck_list() actually detects an uncovered script,
    rather than vacuously passing, by adding then removing one in a scratch tree."""
    name = "shellcheck-coverage-self-test"
    with tempfile.TemporaryDirectory() as tmp:
        root = pathlib.Path(tmp)
        (root / "bin" / "lib").mkdir(parents=True)
        (root / "bin" / "covered").write_text("#!/usr/bin/env bash\necho covered\n")
        ci_text = "for f in bin/covered; do\n"

        if _missing_from_shellcheck_list(root, ci_text):
            return (name, False, "detection flagged bin/covered, which is on the shellcheck list")

        # Two strays: one caught only by its .sh extension, one only by its shebang
        # (like every real top-level bin/ script), so a regression in either
        # detection path makes this test fail.
        stray_sh = root / "bin" / "stray-check.sh"
        stray_sh.write_text("#!/usr/bin/env bash\necho stray\n")
        stray_shebang = root / "bin" / "stray-check"
        stray_shebang.write_text("#!/usr/bin/env bash\necho stray\n")
        missing = _missing_from_shellcheck_list(root, ci_text)
        expected = ["bin/stray-check", "bin/stray-check.sh"]
        if missing != expected:
            return (name, False, f"expected detection to fail, naming {expected}; got {missing}")

        stray_sh.unlink()
        stray_shebang.unlink()
        missing = _missing_from_shellcheck_list(root, ci_text)
        if missing:
            return (name, False, f"expected no missing scripts after removing the stray ones; got {missing}")

        return (name, True, "")


_ROUTINE_BLOCK_HEADINGS = {
    "Issue to PR": r"####\s*2\.[^\n]*\n",
    "Next to Build": r"####\s*5\.[^\n]*\n",
}


def _readme_routine_block(readme_text: str, label: str) -> str | None:
    """The fenced ```text block pasted right after a routine's README heading."""
    pattern = _ROUTINE_BLOCK_HEADINGS[label] + r".*?```text\n(.*?)```"
    match = re.search(pattern, readme_text, re.DOTALL)
    return match.group(1) if match else None


def _prompt_paths(text: str) -> list[str]:
    return re.findall(r"\.claude/prompts/[\w-]+\.md", text)


def _payload_tag(text: str) -> str | None:
    match = re.search(r"<([a-zA-Z][\w-]*)>", text)
    return match.group(1) if match else None


def _routine_block_checks(readme_text: str, issue_to_pr_text: str, root: pathlib.Path) -> list[tuple[str, bool, str]]:
    checks = []
    blocks = {label: _readme_routine_block(readme_text, label) for label in _ROUTINE_BLOCK_HEADINGS}
    for label, block in blocks.items():
        if block is None:
            checks.append((
                f"readme-routine-block:{label}",
                False,
                f'README.md is missing the "{label}" routine instructions block',
            ))
            continue
        for path in _prompt_paths(block):
            checks.append((
                f"readme-routine-block-path:{label}:{path}",
                (root / path).is_file(),
                f'README.md\'s "{label}" routine instructions name {path!r}, which does not exist in the working tree',
            ))
        checks.append((
            f"readme-routine-block-reads-claude-md:{label}",
            "Read CLAUDE.md" in block,
            f'README.md\'s "{label}" routine instructions should tell the routine to read CLAUDE.md',
        ))
    issue_block = blocks.get("Issue to PR")
    if issue_block is not None:
        readme_tag = _payload_tag(issue_block)
        prompt_tag = _payload_tag(issue_to_pr_text)
        checks.append((
            "readme-routine-block-payload-tag",
            readme_tag is not None and readme_tag == prompt_tag,
            f'README.md\'s "Issue to PR" routine instructions name the payload tag {readme_tag!r}, '
            f"but issue-to-pr.md names {prompt_tag!r}",
        ))
    return checks


def _readme_routine_block_checks() -> list[tuple[str, bool, str]]:
    return _routine_block_checks(README, ISSUE_TO_PR, ROOT)


def _routine_block_self_test() -> tuple[str, bool, str]:
    """Proves _routine_block_checks() actually catches each failure mode, in a scratch
    tree, before trusting its result against the real README and issue-to-pr.md."""
    name = "routine-block-self-test"
    issue_to_pr_text = "The `<routine-fire-payload>` block names one GitHub issue."

    def make_readme(issue_tag="routine-fire-payload", next_path=".claude/prompts/next-to-build.md",
                     next_reads_claude_md=True, include_next_block=True) -> str:
        issue_block = (
            f"You implement GitHub issues.\n\nThe <{issue_tag}> block names one issue.\n\n"
            "Read CLAUDE.md and .claude/prompts/issue-to-pr.md, and follow both exactly.\n"
        )
        readme = (
            '#### 2. Create the "Issue to PR" routine\n'
            f"```text\n{issue_block}```\n\n"
            "#### 3. Set two repo values\n"
        )
        if include_next_block:
            next_block = (
                "You decide what to build next.\n\n"
                + ("Read CLAUDE.md and " if next_reads_claude_md else "Follow ")
                + f"{next_path}, and follow both exactly.\n"
            )
            readme += (
                '#### 5. (Optional) Create the "Next to build" routine\n'
                f"```text\n{next_block}```\n"
            )
        return readme

    with tempfile.TemporaryDirectory() as tmp:
        root = pathlib.Path(tmp)
        (root / ".claude" / "prompts").mkdir(parents=True)
        (root / ".claude" / "prompts" / "issue-to-pr.md").write_text("placeholder")
        (root / ".claude" / "prompts" / "next-to-build.md").write_text("placeholder")

        good = make_readme()
        failing = [check_name for check_name, ok, _ in _routine_block_checks(good, issue_to_pr_text, root) if not ok]
        if failing:
            return (name, False, f"expected well-formed README routine blocks to pass; got failing checks {failing}")

        cases = {
            "missing block": lambda: make_readme(include_next_block=False),
            "bad prompt path": lambda: make_readme(next_path=".claude/prompts/does-not-exist.md"),
            "mismatched payload tag": lambda: make_readme(issue_tag="wrong-tag"),
            "missing Read CLAUDE.md": lambda: make_readme(next_reads_claude_md=False),
        }
        for case_name, build in cases.items():
            failing = [check_name for check_name, ok, _ in _routine_block_checks(build(), issue_to_pr_text, root) if not ok]
            if not failing:
                return (name, False, f"expected case {case_name!r} to fail at least one check, but all passed")

        return (name, True, "")


