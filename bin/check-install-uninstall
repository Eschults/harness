#!/usr/bin/env bash
# Functional round trip for `harness install` and `harness uninstall`: runs
# them against a scratch git repo (never this checkout) and asserts the
# files and CLAUDE.md state they claim to produce and clean up. No model
# calls. HARNESS_SRC points install at this repo's own working tree over
# file://, and http(s)_proxy is poisoned so a hardcoded fallback URL (i.e.
# HARNESS_SRC support missing or broken) fails fast instead of quietly
# reaching the real network; file:// fetches never go through a proxy.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$(pwd)

# shellcheck source=bin/lib/check-helpers.sh
source bin/lib/check-helpers.sh
# shellcheck source=bin/harness-cli
source bin/harness-cli

scratch=$(mktemp -d)
outside_repo=$(mktemp -d)
original_claude_md=$(mktemp)
original_review_md=$(mktemp)
trap 'rm -rf "$scratch" "$outside_repo" "$original_claude_md" "$original_review_md"' EXIT

# A PATH with every external tool harness-cli install/uninstall can call,
# gh deliberately left out, so the round-trip assertions below (which don't
# exercise label creation) stay deterministic whether or not gh happens to
# be installed and authenticated in the environment running this check.
no_gh_bin="$scratch/no_gh_bin"
mkdir -p "$no_gh_bin"
for cmd in bash dirname mkdir curl grep awk mv rmdir find cat git rm jq sort tail mktemp head cut cp; do
  cmd_path=$(command -v "$cmd") || continue
  ln -sf "$cmd_path" "$no_gh_bin/$cmd"
done

# Stub gh for the claude-label tests below: routes on the first two args,
# answers from env vars the caller sets, and never touches the network or a
# real repo. `gh label create` calls are appended to $gh_create_log so a
# test can assert whether install left an existing label untouched.
stub_bin="$scratch/stub_bin"
mkdir -p "$stub_bin"
gh_create_log="$scratch/gh-label-create.log"
cat > "$stub_bin/gh" <<STUBEOF
#!/usr/bin/env bash
case "\$1 \$2" in
  "auth status") exit "\${STUB_GH_AUTH_EXIT:-0}" ;;
  "label list")
    [ "\${STUB_GH_LABEL_LIST_EXIT:-0}" = 0 ] || exit "\${STUB_GH_LABEL_LIST_EXIT}"
    printf '%s\n' "\${STUB_GH_LABELS:-}"
    ;;
  "label create")
    echo "\$*" >> "$gh_create_log"
    exit "\${STUB_GH_LABEL_CREATE_EXIT:-0}"
    ;;
  *) exit 1 ;;
esac
STUBEOF
chmod +x "$stub_bin/gh"

git init -q "$scratch"
mkdir -p "$scratch/src/nested"

printf '# Adopter rules\n\nKeep doing the thing.\n' > "$original_claude_md"
cp "$original_claude_md" "$scratch/CLAUDE.md"

# A pre-CLI install's vendored bin/ scripts, which install must clean up.
for f in "${LEGACY_FILES[@]}"; do
  mkdir -p "$scratch/$(dirname "$f")"
  echo "legacy" > "$scratch/$f"
done

export HARNESS_SRC="file://$root"
poison_network

# Runs from a nested directory to prove the CLI finds the repo root itself.
# No gh on PATH by default; see no_gh_bin above.
run_harness() {
  (cd "$scratch/src/nested" && PATH="$no_gh_bin" "$root/bin/harness-cli" "$@")
}

count_import_lines() {
  grep -cxF '@.claude/harness-rules.md' "$scratch/CLAUDE.md" || true
}

if output=$(cd "$outside_repo" && "$root/bin/harness-cli" install 2>&1); then
  fail "expected harness install to fail outside a git repo"
fi
echo "$output" | grep -q "Not inside a git repo" || fail "expected a clear error outside a git repo, got: $output"
echo "✓ install outside a git repo fails clearly"

if ! output=$(run_harness install 2>&1); then
  echo "$output" >&2
  fail "harness install failed with HARNESS_SRC set; check it reads \$HARNESS_SRC instead of a hardcoded src"
fi

for f in "${HARNESS_FILES[@]}"; do
  [ -f "$scratch/$f" ] || fail "expected $f to exist after harness install"
done
[ ! -e "$scratch/src/nested/.claude" ] || fail "expected install to write at the repo root, not the working directory"
echo "✓ install wrote every harness file at the repo root"
echo "$output" | grep -qF "https://github.com/Eschults/harness#setup" || fail "expected a first install to link to the setup steps, got: $output"
echo "✓ a first install links to the remaining setup steps"

for f in "${LEGACY_FILES[@]}"; do
  [ ! -e "$scratch/$f" ] || fail "expected install to remove the legacy $f"
done
[ ! -d "$scratch/bin" ] || fail "expected bin/ to be removed once the legacy scripts emptied it"
echo "✓ install removed the pre-CLI bin/ scripts"

[ "$(count_import_lines)" = "1" ] || fail "expected exactly one @.claude/harness-rules.md line after install, got $(count_import_lines)"
echo "✓ install added exactly one CLAUDE.md import line"

grep -qxF '<!-- harness-review:start (synced by harness install/upgrade from .claude/harness-review.md; do not edit between these markers) -->' "$scratch/REVIEW.md" \
  || fail "expected install to create REVIEW.md with the harness review block, since none existed"
echo "✓ install created REVIEW.md with the harness review block"

echo
echo "--- claude label creation ---"

label_create_dir="$scratch/label-create"
git init -q "$label_create_dir"
: > "$gh_create_log"
if ! output=$(cd "$label_create_dir" && HARNESS_SRC="file://$root" PATH="$stub_bin:$no_gh_bin" \
  STUB_GH_LABELS="" "$root/bin/harness-cli" install 2>&1); then
  echo "$output" >&2
  fail "harness install failed while creating the claude label"
fi
grep -qF "label create claude" "$gh_create_log" 2>/dev/null || fail "expected harness install to call gh label create when the label is missing, got log: $(cat "$gh_create_log" 2>/dev/null)"
grep -qF "D97757" "$gh_create_log" 2>/dev/null || fail "expected harness install to create the claude label with color D97757"
echo "$output" | grep -q "label" && fail "expected the Next message to drop the label step once install creates it, got: $output"
echo "✓ harness install creates the claude label and drops it from the Next message"

label_exists_dir="$scratch/label-exists"
git init -q "$label_exists_dir"
: > "$gh_create_log"
if ! output=$(cd "$label_exists_dir" && HARNESS_SRC="file://$root" PATH="$stub_bin:$no_gh_bin" \
  STUB_GH_LABELS="claude" "$root/bin/harness-cli" install 2>&1); then
  echo "$output" >&2
  fail "harness install failed when the claude label already exists"
fi
[ -s "$gh_create_log" ] && fail "expected harness install to leave an existing claude label untouched, but it called gh label create"
echo "$output" | grep -q "label" && fail "expected the Next message to drop the label step when the label already exists, got: $output"
echo "✓ harness install leaves an existing claude label untouched"

label_no_gh_dir="$scratch/label-no-gh"
git init -q "$label_no_gh_dir"
if ! output=$(cd "$label_no_gh_dir" && HARNESS_SRC="file://$root" PATH="$no_gh_bin" "$root/bin/harness-cli" install 2>&1); then
  echo "$output" >&2
  fail "harness install failed when gh is missing"
fi
echo "$output" | grep -q "label" || fail "expected the Next message to still list the label step when gh is missing, got: $output"
echo "✓ harness install skips the claude label when gh is missing, and says so in the Next message"

label_auth_fail_dir="$scratch/label-auth-fail"
git init -q "$label_auth_fail_dir"
: > "$gh_create_log"
if ! output=$(cd "$label_auth_fail_dir" && HARNESS_SRC="file://$root" PATH="$stub_bin:$no_gh_bin" \
  STUB_GH_AUTH_EXIT=1 "$root/bin/harness-cli" install 2>&1); then
  echo "$output" >&2
  fail "harness install failed when gh is not authenticated"
fi
[ -s "$gh_create_log" ] && fail "expected harness install to skip label creation when gh is not authenticated, but it called gh label create"
echo "$output" | grep -q "label" || fail "expected the Next message to still list the label step when gh is not authenticated, got: $output"
echo "✓ harness install skips the claude label when gh is not authenticated, and says so in the Next message"

label_list_fail_dir="$scratch/label-list-fail"
git init -q "$label_list_fail_dir"
: > "$gh_create_log"
if ! output=$(cd "$label_list_fail_dir" && HARNESS_SRC="file://$root" PATH="$stub_bin:$no_gh_bin" \
  STUB_GH_LABEL_LIST_EXIT=1 "$root/bin/harness-cli" install 2>&1); then
  echo "$output" >&2
  fail "harness install failed when gh label list fails"
fi
[ -s "$gh_create_log" ] && fail "expected harness install to skip label creation when gh label list fails, but it called gh label create"
echo "$output" | grep -q "label" || fail "expected the Next message to still list the label step when gh label list fails, got: $output"
echo "✓ harness install skips the claude label when gh label list fails, and says so in the Next message"
echo

if ! output=$(run_harness install 2>&1); then
  echo "$output" >&2
  fail "harness install failed on re-run"
fi
[ "$(count_import_lines)" = "1" ] || fail "expected exactly one @.claude/harness-rules.md line after re-running install, got $(count_import_lines)"
echo "$output" | grep -q "#setup" && fail "expected a re-run install to skip the first-time setup pointer, got: $output"
echo "$output" | grep -q "run harness doctor" || fail "expected a re-run install to point at harness doctor, got: $output"
echo "✓ re-running install did not duplicate the CLAUDE.md import line"

if ! output=$(run_harness uninstall 2>&1); then
  echo "$output" >&2
  fail "harness uninstall failed"
fi

for f in "${HARNESS_FILES[@]}"; do
  [ ! -e "$scratch/$f" ] || fail "expected $f to be removed by harness uninstall"
done
[ ! -d "$scratch/.claude/prompts" ] || fail "expected .claude/prompts to be removed once empty"

cmp -s "$scratch/CLAUDE.md" "$original_claude_md" || fail "expected CLAUDE.md to return to its pre-install content byte for byte"
echo "✓ uninstall removed every harness file and restored CLAUDE.md"

[ ! -e "$scratch/REVIEW.md" ] || fail "expected uninstall to remove REVIEW.md, since install created it from nothing"
echo "✓ uninstall removed the REVIEW.md it had created from nothing"

echo
echo "--- REVIEW.md with the adopter's own content ---"

review_dir="$scratch/review-adopter-content"
git init -q "$review_dir"
printf '# Our rules\n\nNo nits on generated code.\n' > "$original_review_md"
cp "$original_review_md" "$review_dir/REVIEW.md"

run_harness_in() {
  local dir=$1
  shift
  (cd "$dir" && HARNESS_SRC="file://$root" PATH="$no_gh_bin" "$root/bin/harness-cli" "$@")
}

if ! output=$(run_harness_in "$review_dir" install 2>&1); then
  echo "$output" >&2
  fail "harness install failed with a pre-existing REVIEW.md"
fi
grep -qxF '# Our rules' "$review_dir/REVIEW.md" || fail "expected install to keep the adopter's own REVIEW.md content"
grep -qxF '<!-- harness-review:start (synced by harness install/upgrade from .claude/harness-review.md; do not edit between these markers) -->' "$review_dir/REVIEW.md" \
  || fail "expected install to append the harness review block to an existing REVIEW.md"
echo "✓ install appended the harness review block, keeping the adopter's own REVIEW.md content"

if ! output=$(run_harness_in "$review_dir" install 2>&1); then
  echo "$output" >&2
  fail "harness install failed re-running against a REVIEW.md that already has the block"
fi
[ "$(grep -c 'harness-review:start' "$review_dir/REVIEW.md")" = "1" ] || fail "expected re-running install to refresh the block in place, not duplicate it"
echo "✓ re-running install refreshed the REVIEW.md block instead of duplicating it"

if ! output=$(run_harness_in "$review_dir" uninstall 2>&1); then
  echo "$output" >&2
  fail "harness uninstall failed removing the REVIEW.md block"
fi
cmp -s "$review_dir/REVIEW.md" "$original_review_md" || fail "expected uninstall to restore REVIEW.md to its pre-install content byte for byte"
echo "✓ uninstall removed the block and restored the adopter's REVIEW.md content byte for byte"

if ! output=$(run_harness uninstall 2>&1); then
  echo "$output" >&2
  fail "harness uninstall failed on re-run against an already-uninstalled repo"
fi
echo "✓ re-running uninstall on an already-uninstalled repo still exits cleanly"

if output=$("$root/bin/harness-cli" bogus 2>&1); then
  fail "expected an unknown command to fail"
fi
echo "$output" | grep -q "Usage: harness <command>" || fail "expected an unknown command to print usage, got: $output"
echo "✓ an unknown command fails with usage"

echo
echo "install/uninstall round trip: all passed"
