#!/usr/bin/env bash
# The harness CLI: installs, upgrades, checks, and uninstalls the harness in
# the git repo it runs from, and fires the "Issue to PR" routine by hand.
# Run through bin/harness, which picks the version a repo pins and sets HARNESS_SRC to that release.
set -euo pipefail

HARNESS_DEFAULT_SRC=https://raw.githubusercontent.com/Eschults/harness/v1
HARNESS_README=https://github.com/Eschults/harness
HARNESS_FILES=(
  ".github/workflows/claude.yml"
  ".claude/prompts/issue-to-pr.md"
  ".claude/prompts/next-to-build.md"
  ".claude/harness-rules.md"
  ".claude/HARNESS_VERSION"
)
# What the pre-CLI harness vendored into bin/; install and uninstall remove it.
LEGACY_FILES=(
  "bin/harness-install"
  "bin/harness-upgrade"
  "bin/harness-uninstall"
  "bin/harness-doctor"
  "bin/fire-issue"
  "bin/lib/fetch-files.sh"
  "bin/lib/version-check.sh"
)
RULES_IMPORT='@.claude/harness-rules.md'
# name|color|description, in display order. install creates whichever of
# these GitHub doesn't already have; doctor reports whichever is missing.
HARNESS_LABELS=(
  "claude|D97757|starts a Claude Code run"
  "risk:low|0E8A16|low risk PR: docs, copy, and tests only"
  "risk:medium|FBCA04|medium risk PR: the harness default"
  "risk:high|B60205|high risk PR: a stop topic, a never-edit path, CI/workflows, a dependency, or a public API"
)

usage() {
  cat <<'EOF'
Usage: harness <command>

Commands:
  install          Fetch the harness files into this repo and import the rules into CLAUDE.md
  upgrade          Pull in the latest harness release
  doctor [--fire]  Check the install end to end; --fire also fires the routine once
  issue <number>   Fire the "Issue to PR" routine for one issue, bypassing GitHub Actions
  stats [--since <N>d]  Report what claude/ pull requests become (default 30d)
  uninstall        Remove the harness files and the CLAUDE.md import
  -v, --version    Print the harness version this repo runs

Run it from anywhere inside your project's git repo.
EOF
}

harness_src() {
  echo "${HARNESS_SRC:-$HARNESS_DEFAULT_SRC}"
}

# The raw-content base for one exact release tag, unlike harness_src() which
# points at the floating major ref (v1) install/upgrade pull from. Doctor
# needs the exact pinned tag to tell whether a file has drifted from it.
# Overridable for tests via HARNESS_RELEASE_SRC, same style as harness_tags_url().
harness_release_src() {
  echo "${HARNESS_RELEASE_SRC:-${HARNESS_DEFAULT_SRC%/*}}/$1"
}

harness_tags_url() {
  echo "${HARNESS_TAGS_URL:-https://api.github.com/repos/Eschults/harness/tags}"
}

require_tools() {
  local tool
  for tool in "$@"; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "$tool not found; install it (e.g. apt-get install $tool, or brew install $tool) to run harness ${harness_command:-}." >&2
      exit 1
    fi
  done
}

cd_repo_root() {
  local root
  if ! root=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "Not inside a git repo; run harness from your project's repo." >&2
    exit 1
  fi
  cd "$root"
}

# The major this CLI fetches from (v1); a newer major needs a CLI reinstall, so upgrade never offers it.
harness_major() {
  echo "${HARNESS_DEFAULT_SRC##*/}"
}

# Fails (non-zero) on a lookup error, so callers under set -e must handle it.
latest_harness_version() {
  # grep matching nothing is fine; pipefail would otherwise abort with no message.
  curl -fsSL "$(harness_tags_url)" | jq -r '.[].name' | { grep -E "^$(harness_major)\.[0-9]+\.[0-9]+$" || true; } | sort -V | tail -1
}

# Lists harness files with uncommitted (modified or staged) changes. Leaves
# an untracked file off the list: a repo that installed but never committed
# has every harness file untracked, and that's the normal pre-commit state,
# not an edit upgrade would destroy.
dirty_harness_files() {
  local f
  for f in "${HARNESS_FILES[@]}"; do
    [ -e "$f" ] || continue
    if ! git diff --quiet -- "$f" 2>/dev/null || ! git diff --cached --quiet -- "$f" 2>/dev/null; then
      echo "$f"
    fi
  done
}

# Lists tracked harness files (except HARNESS_VERSION itself) whose local
# content differs from the same file at release $1. Fails (non-zero) when a
# file can't be fetched, so the caller can tell "the release is unreachable"
# apart from "nothing differs". A missing local file is left to the
# file-presence check and never counted as drifted.
drifted_harness_files() {
  local version=$1 f base tmp
  base=$(harness_release_src "$version")
  # cmp on a fetched file, not a $(...)-captured string: command substitution
  # strips trailing newlines, which would hide a file that differs only by
  # one. Redirect with `>`, not curl's own -o, so a test's curl stub that
  # special-cases -o for the --fire check doesn't intercept this call too.
  tmp=$(mktemp) || return 1
  for f in "${HARNESS_FILES[@]}"; do
    [ "$f" = ".claude/HARNESS_VERSION" ] && continue
    [ -f "$f" ] || continue
    if ! curl -fsSL "$base/$f" > "$tmp"; then
      rm -f "$tmp"
      return 1
    fi
    cmp -s "$tmp" "$f" || echo "$f"
  done
  rm -f "$tmp"
}

require_clean_harness_files() {
  local dirty f
  dirty=$(dirty_harness_files)
  if [ -n "$dirty" ]; then
    echo "Uncommitted changes in these harness files would be overwritten; commit or stash them and re-run:" >&2
    while IFS= read -r f; do
      echo "  $f" >&2
    done <<< "$dirty"
    exit 1
  fi
}

fetch_harness_files() {
  local src f
  src=$(harness_src)
  for f in "${HARNESS_FILES[@]}"; do
    mkdir -p "$(dirname "$f")"
    curl -fsSL "$src/$f" -o "$f"
  done
}

remove_empty_dirs() {
  local d
  # Adopters may keep their own files in these folders, so only remove one
  # once it's explicitly confirmed empty.
  for d in "$@"; do
    if [ -d "$d" ] && [ -z "$(find "$d" -mindepth 1 -print -quit)" ]; then
      rmdir "$d"
    fi
  done
}

remove_legacy_files() {
  local f removed=0
  for f in "${LEGACY_FILES[@]}"; do
    if [ -e "$f" ]; then
      rm -f "$f"
      removed=1
    fi
  done
  if [ "$removed" -eq 1 ]; then
    remove_empty_dirs bin/lib bin
    echo "Removed the pre-CLI bin/ scripts; use the harness command instead."
  fi
}

install_harness() {
  fetch_harness_files
  remove_legacy_files
  if ! grep -qF "$RULES_IMPORT" CLAUDE.md 2>/dev/null; then
    printf '\n%s\n' "$RULES_IMPORT" >> CLAUDE.md
  fi
}

# --limit: gh label list defaults to 30 and the claude label can sort past
# that on a repo that already has many labels.
gh_label_names() {
  gh label list --limit 1000 --json name --jq '.[].name' 2>/dev/null
}

# Ensures every label in HARNESS_LABELS exists. Leaves an existing label
# alone, even one with a different color or description, since install must
# never fight an adopter's own edit to it. Fetches gh's auth status and
# label list once for every label, not once per label, same as cmd_doctor's
# own label loop below. Returns non-zero when gh is missing, unauthenticated,
# the list call fails, or a create call fails, so the caller can skip
# quietly and point at the README fallback instead of guessing at a label's
# real state.
ensure_harness_labels() {
  command -v gh >/dev/null 2>&1 || return 1
  gh auth status >/dev/null 2>&1 || return 1
  local labels entry name color description all_ok=0
  labels=$(gh_label_names) || return 1
  for entry in "${HARNESS_LABELS[@]}"; do
    IFS='|' read -r name color description <<< "$entry"
    echo "$labels" | grep -qxF "$name" && continue
    gh label create "$name" --color "$color" --description "$description" >/dev/null 2>&1 || all_ok=1
  done
  return "$all_ok"
}

cmd_install() {
  require_tools curl
  cd_repo_root
  local first_install=0
  [ -f .claude/HARNESS_VERSION ] || first_install=1
  install_harness
  local labels_done=1
  ensure_harness_labels || labels_done=0
  echo "Installed the harness at $(<.claude/HARNESS_VERSION)."
  if [ "$first_install" -eq 1 ]; then
    local remaining="create the routines and repo values"
    [ "$labels_done" -eq 1 ] || remaining="create the routines, labels, and repo values"
    echo "Next: $remaining ($HARNESS_README#setup), then run harness doctor."
  else
    echo "Next: run harness doctor to check the setup."
  fi
}

cmd_upgrade() {
  require_tools curl jq
  cd_repo_root

  local current latest release_notes confirm
  current=$(cat .claude/HARNESS_VERSION 2>/dev/null || true)
  if [ -z "$current" ]; then
    echo "No .claude/HARNESS_VERSION found; run harness install first." >&2
    exit 1
  fi

  require_clean_harness_files

  # Set by a v1.3.x CLI that just replaced itself with bin/harness, so the confirmed upgrade resumes without re-asking.
  if [ -z "${HARNESS_UPGRADE_CONFIRMED:-}" ]; then
    latest=$(latest_harness_version)
    if [ -z "$latest" ]; then
      echo "No $(harness_major).Y.Z release tag found at $(harness_tags_url)" >&2
      exit 1
    fi

    if [ "$current" = "$latest" ]; then
      echo "Already up to date: $current"
      exit 0
    fi

    release_notes="https://github.com/Eschults/harness/releases/tag/$latest"
    echo "Upgrading $current -> $latest: $release_notes"
    open "$release_notes" 2>/dev/null || xdg-open "$release_notes" 2>/dev/null || true

    read -rp "Pull in $latest now? [y/N] " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo "Skipped. Re-run harness upgrade when you're ready."
      exit 0
    fi

  fi
  install_harness
  echo "Pulled in $(<.claude/HARNESS_VERSION). Review the diff and commit."
}

cmd_uninstall() {
  cd_repo_root

  local f
  for f in "${HARNESS_FILES[@]}" "${LEGACY_FILES[@]}"; do
    rm -f "$f"
  done
  remove_empty_dirs .claude/prompts bin/lib bin

  if [ -f CLAUDE.md ] && grep -qxF "$RULES_IMPORT" CLAUDE.md; then
    # install appends the import behind a blank line it inserts; drop that
    # blank line along with the import, or CLAUDE.md never quite returns to
    # its pre-install content.
    awk -v import="$RULES_IMPORT" '
      $0 == import {
        if (have && pending == "") have = 0
        next
      }
      { if (have) print pending; pending = $0; have = 1 }
      END { if (have) print pending }
    ' CLAUDE.md > CLAUDE.md.harness-uninstall-tmp
    mv CLAUDE.md.harness-uninstall-tmp CLAUDE.md
  fi

  cat <<EOF
Removed the local harness files. Finish the cleanup on GitHub:
  - Delete the "Issue to PR" and "Next to Build" routines: https://claude.ai/code/routines
  - Delete the label:     gh label delete claude --yes
  - Remove the variable:  gh variable delete CLAUDE_ROUTINE_ID
  - Remove the secret:    gh secret delete CLAUDE_ROUTINE_TOKEN
The harness command itself stays installed for your other repos.
EOF
}

# POSTs one /fire request with $2 as its text, writing the body to $1 and
# printing the HTTP status (0 when the API was unreachable).
fire_routine() {
  local response=$1 text=$2 status xtrace_was_on
  # Disables xtrace for the call itself, then restores it, so a caller
  # running under `bash -x` never gets the token echoed as part of the
  # expanded curl command line.
  case $- in *x*) xtrace_was_on=1 ;; *) xtrace_was_on=0 ;; esac
  set +x
  # No --retry: the POST is not idempotent, a re-send starts a second session.
  if ! status=$(curl -sS -o "$response" -w '%{http_code}' --max-time 60 \
    -X POST "https://api.anthropic.com/v1/claude_code/routines/${CLAUDE_ROUTINE_ID}/fire" \
    -H "Authorization: Bearer ${CLAUDE_ROUTINE_TOKEN}" \
    -H "anthropic-beta: experimental-cc-routine-2026-04-01" \
    -H "anthropic-version: 2023-06-01" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg text "$text" '{text: $text}')" 2>/dev/null); then
    status=0
  fi
  [ "$xtrace_was_on" -eq 1 ] && set -x
  echo "$status"
}

fire_failure_reason() {
  case "$1" in
    0) echo "could not reach the API (network problem)" ;;
    401 | 403) echo "bad token" ;;
    404) echo "wrong routine id" ;;
    429) echo "routine rate limit or subscription usage limit reached" ;;
    *) echo "see $HARNESS_README#3-set-two-repo-values" ;;
  esac
}

# Reads KEY from the repo's .env by parsing it, never sourcing it, so nothing in .env runs.
dotenv_value() {
  local key=$1 line value
  [ -f .env ] || return 1
  line=$(grep -E "^[[:space:]]*(export[[:space:]]+)?$key=" .env | tail -1) || return 1
  value=${line#*=}
  value=${value%$'\r'}
  if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
    value=${value:1:${#value}-2}
  fi
  echo "$value"
}

# The environment wins; .env fills in whatever it leaves unset, so a plain `source .env` (no export) isn't needed.
load_routine_credentials() {
  [ -n "${CLAUDE_ROUTINE_ID:-}" ] || CLAUDE_ROUTINE_ID=$(dotenv_value CLAUDE_ROUTINE_ID || true)
  [ -n "${CLAUDE_ROUTINE_TOKEN:-}" ] || CLAUDE_ROUTINE_TOKEN=$(dotenv_value CLAUDE_ROUTINE_TOKEN || true)
}

routine_credentials_set() {
  [ -n "${CLAUDE_ROUTINE_ID:-}" ] && [ -n "${CLAUDE_ROUTINE_TOKEN:-}" ]
}

cmd_issue() {
  local issue=${1:-}
  if [ -z "$issue" ] || ! [[ "$issue" =~ ^[0-9]+$ ]]; then
    echo "Usage: harness issue <issue-number>" >&2
    exit 1
  fi

  require_tools curl jq gh
  cd_repo_root

  load_routine_credentials
  if ! routine_credentials_set; then
    echo "CLAUDE_ROUTINE_ID or CLAUDE_ROUTINE_TOKEN is not set in the environment or .env. See $HARNESS_README#3-set-two-repo-values" >&2
    exit 1
  fi

  local repo issue_url text status session_url
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
  issue_url=$(gh issue view "$issue" --json url -q .url)
  text=$(printf 'Repository: %s\nIssue: #%s\nURL: %s\n' "$repo" "$issue" "$issue_url")

  # Global, not local: the EXIT trap runs after this function's scope is gone.
  issue_response=$(mktemp)
  trap 'rm -f "$issue_response"' EXIT

  status=$(fire_routine "$issue_response" "$text")
  if [ "$status" -lt 200 ] || [ "$status" -ge 300 ]; then
    echo "Routine fire failed with HTTP $status ($(fire_failure_reason "$status"))" >&2
    jq . "$issue_response" 2>/dev/null >&2 || cat "$issue_response" >&2
    exit 1
  fi

  session_url=$(jq -r '.claude_code_session_url // empty' "$issue_response")
  if [ -z "$session_url" ]; then
    echo "Routine fire returned HTTP $status with no session URL in the response" >&2
    cat "$issue_response" >&2
    exit 1
  fi

  gh issue comment "$issue" --body "Claude is looking into it :point_right: $session_url incoming PR :hourglass_flowing_sand:"
  echo "Fired: $session_url"
}

# Prints an ISO-8601 UTC timestamp $1 days before now, or before
# $HARNESS_STATS_NOW when set (so tests get a deterministic cutoff). Tries
# GNU date first, then BSD/macOS date, since the CLI runs on both.
stats_since_iso() {
  local days=$1 base=${HARNESS_STATS_NOW:-now}
  date -u -d "$base -${days} days" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null && return
  if [ "$base" = now ]; then
    date -u -v-"${days}"d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null && return
  else
    date -ju -f '%Y-%m-%dT%H:%M:%SZ' -v-"${days}"d "$base" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null && return
  fi
  return 1
}

# Pages through a gh api GET endpoint (--method GET, since -f fields default
# gh api to POST) whose response is a bare JSON array,
# appending each page's items as one compact JSON object per line to $1.
# $2 is the endpoint; any further args are extra -f fields. Stops once a
# page returns fewer than 100 items. Fails (non-zero) if any page's call
# fails, so a caller never mistakes a lookup error for an empty result.
paginate_gh_api() {
  local out=$1 endpoint=$2
  shift 2
  local page=1 per_page=100 tmp count
  : > "$out"
  while :; do
    tmp=$(mktemp) || return 1
    if ! gh api "$endpoint" --method GET -f per_page="$per_page" -f page="$page" "$@" > "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      return 1
    fi
    jq -c '.[]' "$tmp" >> "$out"
    count=$(jq 'length' "$tmp")
    rm -f "$tmp"
    [ "$count" -lt "$per_page" ] && break
    page=$((page + 1))
  done
}

# Same page shape as paginate_gh_api, but for state=all pull requests sorted
# by created desc: stops as soon as a page's oldest PR predates $2, so a
# long-lived repo's full PR history is never fetched for a short --since
# window. Writes only PRs with created_at >= $2.
fetch_prs_since() {
  local out=$1 since_iso=$2 page=1 per_page=100 tmp count oldest
  : > "$out"
  while :; do
    tmp=$(mktemp) || return 1
    if ! gh api 'repos/{owner}/{repo}/pulls' --method GET -f state=all -f sort=created -f direction=desc \
      -f per_page="$per_page" -f page="$page" > "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      return 1
    fi
    jq -c --arg since "$since_iso" '.[] | select(.created_at >= $since)' "$tmp" >> "$out"
    count=$(jq 'length' "$tmp")
    oldest=$(jq -r '.[-1].created_at // empty' "$tmp")
    rm -f "$tmp"
    [ "$count" -lt "$per_page" ] && break
    [ -n "$oldest" ] && [[ "$oldest" < "$since_iso" ]] && break
    page=$((page + 1))
  done
}

# True when every commit on PR $1's branch was authored by the run itself
# (git author email noreply@anthropic.com, the identity every routine
# commit carries) rather than a human push. Fails (non-zero, treated as "not
# solo" by the caller) if the commits can't be listed.
stats_pr_is_claude_only() {
  local number=$1 tmp non_claude
  tmp=$(mktemp) || return 1
  if ! paginate_gh_api "$tmp" "repos/{owner}/{repo}/pulls/$number/commits"; then
    rm -f "$tmp"
    return 1
  fi
  non_claude=$(jq -s '[.[] | select((.commit.author.email // "") != "noreply@anthropic.com")] | length' "$tmp")
  rm -f "$tmp"
  [ "$non_claude" -eq 0 ]
}

# The jq summary of claude/-branch PR stats, run against $prs (every PR
# touched by the --since window, any branch) and $commits (default-branch
# commits since the cutoff). Embedded here, not a sibling bin/lib/*.jq file:
# `harness` downloads only this one file per release (see ensure_cli in
# bin/harness), so a separate file would 404 for anyone but this checkout.
stats_jq_filter() {
  cat <<'JQ'
$prs as $all
| $commits as $default_commits
| [$all[] | select(.head.ref | startswith("claude/"))] as $claude
| [$claude[] | select(.merged_at != null)] as $merged
| [$claude[] | select(.state == "closed" and .merged_at == null)] as $closed_unmerged
| [$claude[] | select(.draft == true and .state == "open")] as $still_draft
| ($merged | sort_by(.merged_at)) as $merged_by_time
| [
    $all[] | select(.merged_at != null) as $r
    | ($merged_by_time
        | map(select(("Revert \"" + .title + "\"") == $r.title and .merged_at <= $r.merged_at))
        | sort_by(.merged_at)
        | last
      ) as $target
    | select($target != null)
    | {number: $target.number, link: $r.html_url}
  ] as $title_hits
| [
    $merged[] as $pr
    | $default_commits[]
    | select(.commit.message | contains("This reverts commit " + ($pr.merge_commit_sha // "~")))
    | {number: $pr.number, link: .html_url}
  ] as $commit_hits
| ($title_hits + $commit_hits) as $all_hits
| [
    $merged[] | . as $pr
    | ([$all_hits[] | select(.number == $pr.number) | .link] | unique) as $links
    | select(($links | length) > 0)
    | {number: $pr.number, title: $pr.title, reverted_by: $links}
  ] as $reverts
| ([$claude[] | (.labels // [])[].name | select(startswith("risk:"))] | unique) as $tiers
| (
    if ($tiers | length) == 0 then null
    else [
      $tiers[] as $tier
      | {
          tier: $tier,
          opened: ([$claude[] | select(any((.labels // [])[]; .name == $tier))] | length),
          merged: ([$merged[] | select(any((.labels // [])[]; .name == $tier))] | length)
        }
    ]
    end
  ) as $by_tier
| {
    opened: ($claude | length),
    merged: ($merged | length),
    closed_unmerged: ($closed_unmerged | length),
    still_draft: ($still_draft | length),
    merged_numbers: [$merged[] | .number],
    reverts: $reverts,
    by_tier: $by_tier
  }
JQ
}

cmd_stats() {
  local since_days=30
  while [ $# -gt 0 ]; do
    case "$1" in
      --since)
        [ $# -ge 2 ] || { echo "Usage: harness stats [--since <N>d]" >&2; exit 1; }
        since_days=${2%d}
        shift 2
        ;;
      *)
        echo "Unknown option: $1. Usage: harness stats [--since <N>d]" >&2
        exit 1
        ;;
    esac
  done
  [[ "$since_days" =~ ^[0-9]+$ ]] || { echo "Invalid --since value: expected <N>d (e.g. 30d)" >&2; exit 1; }

  require_tools gh jq
  cd_repo_root

  if ! gh auth status >/dev/null 2>&1; then
    echo "gh is not authenticated; run gh auth login." >&2
    exit 1
  fi

  local since_iso default_branch
  since_iso=$(stats_since_iso "$since_days") || { echo "Could not compute the --since cutoff date." >&2; exit 1; }
  default_branch=$(gh api 'repos/{owner}/{repo}' --jq .default_branch 2>/dev/null) ||
    { echo "Could not look up the default branch." >&2; exit 1; }

  # Global, not local: the EXIT trap runs after this function's scope is gone.
  stats_scratch=$(mktemp -d)
  trap 'rm -rf "$stats_scratch"' EXIT

  local prs_file="$stats_scratch/prs.jsonl" commits_file="$stats_scratch/commits.jsonl"
  fetch_prs_since "$prs_file" "$since_iso" || { echo "Could not list pull requests." >&2; exit 1; }
  paginate_gh_api "$commits_file" 'repos/{owner}/{repo}/commits' -f sha="$default_branch" -f since="$since_iso" ||
    { echo "Could not list commits on $default_branch." >&2; exit 1; }

  local summary
  summary=$(jq -n --slurpfile prs "$prs_file" --slurpfile commits "$commits_file" "$(stats_jq_filter)") ||
    { echo "Could not summarize pull request data." >&2; exit 1; }

  echo "Harness stats since $since_iso (last ${since_days}d)"
  echo
  echo "claude/ pull requests: $(jq -r .opened <<< "$summary") opened, $(jq -r .merged <<< "$summary") merged, $(jq -r .closed_unmerged <<< "$summary") closed unmerged, $(jq -r .still_draft <<< "$summary") still draft"

  local solo=0 checked=0 num
  while IFS= read -r num; do
    [ -n "$num" ] || continue
    checked=$((checked + 1))
    stats_pr_is_claude_only "$num" && solo=$((solo + 1))
  done < <(jq -r '.merged_numbers[]' <<< "$summary")
  echo "Merged with no human pushes: $solo/$checked"

  local revert_count
  revert_count=$(jq '.reverts | length' <<< "$summary")
  echo "Reverted: $revert_count"
  if [ "$revert_count" -gt 0 ]; then
    jq -r '.reverts[] | "  #\(.number) \(.title) -> " + (.reverted_by | join(", "))' <<< "$summary"
  fi

  if jq -e '.by_tier != null' <<< "$summary" >/dev/null; then
    echo
    echo "By risk tier:"
    jq -r '.by_tier[] | "  \(.tier): \(.opened) opened, \(.merged) merged"' <<< "$summary"
  fi
}

doctor_failed=0
ok() { echo "✓ $1"; }
bad() {
  echo "✗ $1"
  doctor_failed=1
}
skip() { echo "- $1 (skipped: $2)"; }
warn() { echo "⚠ $1"; }

# Verifies the install end to end: the local files, whether the pinned
# .claude/HARNESS_VERSION is the latest release, the CLAUDE.md import, the
# GitHub-side label/variable/secret, that the files are merged to the
# default branch (where the routine actually reads them from), and a
# gitignored .env if one exists. Never prints a secret value.
cmd_doctor() {
  local fire=0 arg tool f
  for arg in "$@"; do
    case "$arg" in
      --fire) fire=1 ;;
      *)
        echo "Unknown option: $arg. Usage: harness doctor [--fire]" >&2
        exit 1
        ;;
    esac
  done

  cd_repo_root

  for tool in curl jq; do
    if command -v "$tool" >/dev/null 2>&1; then
      ok "$tool is on PATH"
    else
      bad "$tool is missing; install it (e.g. apt-get install $tool, or brew install $tool)"
    fi
  done

  for f in "${HARNESS_FILES[@]}"; do
    if [ -f "$f" ]; then
      ok "$f exists"
    else
      bad "$f is missing; run harness install"
    fi
  done

  local pinned latest
  if [ -f .claude/HARNESS_VERSION ]; then
    pinned=$(<.claude/HARNESS_VERSION)
    if latest=$(latest_harness_version 2>/dev/null) && [ -n "$latest" ]; then
      if [ "$pinned" = "$latest" ]; then
        ok "harness is on the latest release ($pinned)"
      else
        bad "harness is on $pinned but $latest is the latest release; run harness upgrade"
      fi
    else
      skip "harness version" "could not look up the latest release tag"
    fi
  else
    skip "harness version" ".claude/HARNESS_VERSION is missing"
  fi

  if [ -n "${pinned:-}" ]; then
    local drifted
    if drifted=$(drifted_harness_files "$pinned"); then
      if [ -n "$drifted" ]; then
        while IFS= read -r f; do
          warn "$f differs from the pinned release ($pinned); harness upgrade will overwrite it"
        done <<< "$drifted"
      else
        ok "every harness file matches the pinned release ($pinned)"
      fi
    else
      skip "harness files match the pinned release" "could not fetch harness files from $pinned"
    fi
  else
    skip "harness files match the pinned release" ".claude/HARNESS_VERSION is missing"
  fi

  # Matches the substring check install itself uses to decide whether to
  # append the import, so a failure here is always fixable by running it.
  if [ -f CLAUDE.md ] && grep -qF "$RULES_IMPORT" CLAUDE.md; then
    ok "CLAUDE.md imports $RULES_IMPORT"
  else
    bad "CLAUDE.md does not import $RULES_IMPORT; run harness install"
  fi

  local label_checks=()
  local entry name color description
  for entry in "${HARNESS_LABELS[@]}"; do
    IFS='|' read -r name color description <<< "$entry"
    label_checks+=("$name label")
  done
  local gh_checks=("${label_checks[@]}" "CLAUDE_ROUTINE_ID variable" "CLAUDE_ROUTINE_TOKEN secret" "harness files on the default branch" "GitHub Actions enabled" "claude.yml workflow active")
  local c labels variables secrets default_branch default_branch_tree actions_enabled workflow_state
  if ! command -v gh >/dev/null 2>&1; then
    for c in "${gh_checks[@]}"; do skip "$c" "gh is not installed"; done
  elif ! gh auth status >/dev/null 2>&1; then
    for c in "${gh_checks[@]}"; do skip "$c" "gh is not authenticated; run gh auth login"; done
  else
    # A failed list call (rate limit, a token without label read access) is a
    # lookup problem, not evidence a label is missing, so it must skip rather
    # than report a false failure.
    if labels=$(gh_label_names); then
      for entry in "${HARNESS_LABELS[@]}"; do
        IFS='|' read -r name color description <<< "$entry"
        if echo "$labels" | grep -qxF "$name"; then
          ok "$name label exists"
        else
          bad "$name label is missing; run: gh label create \"$name\" --color $color --description \"$description\" --force"
        fi
      done
    else
      for entry in "${HARNESS_LABELS[@]}"; do
        IFS='|' read -r name _ _ <<< "$entry"
        skip "$name label" "could not list labels"
      done
    fi

    # A failed list call (rate limit, a fine-grained PAT missing the
    # Variables/Secrets scope) is a lookup problem, not evidence the variable
    # or secret is unset, so it must skip rather than report a false failure.
    if variables=$(gh variable list --json name --jq '.[].name' 2>/dev/null); then
      if echo "$variables" | grep -qxF CLAUDE_ROUTINE_ID; then
        ok "CLAUDE_ROUTINE_ID variable is set"
      else
        bad "CLAUDE_ROUTINE_ID variable is not set; see $HARNESS_README#3-set-two-repo-values"
      fi
    else
      skip "CLAUDE_ROUTINE_ID variable" "could not list variables"
    fi

    if secrets=$(gh secret list --json name --jq '.[].name' 2>/dev/null); then
      if echo "$secrets" | grep -qxF CLAUDE_ROUTINE_TOKEN; then
        ok "CLAUDE_ROUTINE_TOKEN secret is set"
      else
        bad "CLAUDE_ROUTINE_TOKEN secret is not set; see $HARNESS_README#3-set-two-repo-values"
      fi
    else
      skip "CLAUDE_ROUTINE_TOKEN secret" "could not list secrets"
    fi

    # The routine reads the harness files from the default branch, not from
    # whatever's checked out locally, so a two-call failure (branch name, then
    # its tree) is a lookup problem, not evidence the files are missing.
    if default_branch=$(gh api 'repos/{owner}/{repo}' --jq .default_branch 2>/dev/null) && [ -n "$default_branch" ] &&
      default_branch_tree=$(gh api "repos/{owner}/{repo}/git/trees/$default_branch?recursive=true" --jq '.tree[].path' 2>/dev/null); then
      for f in "${HARNESS_FILES[@]}"; do
        if printf '%s\n' "$default_branch_tree" | grep -qxF "$f"; then
          ok "$f exists on the default branch ($default_branch)"
        else
          bad "$f is missing on the default branch ($default_branch); merge the harness files to $default_branch"
        fi
      done
    else
      skip "harness files on the default branch" "could not look up the default branch"
    fi

    # A failed lookup (no admin permission to read the Actions settings, no
    # network) is a lookup problem, not evidence Actions is disabled, so it
    # must skip rather than report a false failure.
    if actions_enabled=$(gh api 'repos/{owner}/{repo}/actions/permissions' --jq .enabled 2>/dev/null); then
      if [ "$actions_enabled" = "true" ]; then
        ok "GitHub Actions is enabled for this repo"
      else
        bad "GitHub Actions is disabled for this repo; enable it: Settings → Actions → General"
      fi
    else
      skip "GitHub Actions enabled" "could not read the Actions permissions setting"
    fi

    # A failed lookup (the workflow not yet merged to the default branch, no
    # network) is a lookup problem, not evidence the workflow is disabled, so
    # it must skip rather than report a false failure.
    if workflow_state=$(gh api 'repos/{owner}/{repo}/actions/workflows/claude.yml' --jq .state 2>/dev/null); then
      if [ "$workflow_state" = "active" ]; then
        ok "claude.yml workflow is active"
      else
        bad "claude.yml workflow is disabled; run: gh workflow enable claude.yml"
      fi
    else
      skip "claude.yml workflow active" "could not look up the workflow"
    fi
  fi

  local response status session_url
  if [ "$fire" -eq 1 ]; then
    load_routine_credentials
    if ! routine_credentials_set; then
      skip "routine fire" "CLAUDE_ROUTINE_ID or CLAUDE_ROUTINE_TOKEN is not set in the environment or .env"
    elif ! command -v jq >/dev/null 2>&1; then
      skip "routine fire" "jq is not installed"
    else
      response=$(mktemp)
      status=$(fire_routine "$response" "Setup check. Reply with the repo name and stop.")
      if [ "$status" -ge 200 ] && [ "$status" -lt 300 ]; then
        session_url=$(jq -r '.claude_code_session_url // empty' "$response" 2>/dev/null) || session_url=""
        if [ -n "$session_url" ]; then
          ok "routine fire succeeded: $session_url"
        else
          bad "routine fire returned HTTP $status with no session URL in the response"
        fi
      else
        bad "routine fire failed with HTTP $status ($(fire_failure_reason "$status"))"
      fi
      rm -f "$response"
    fi
  fi

  if [ -f .env ]; then
    if git ls-files --error-unmatch .env >/dev/null 2>&1; then
      bad ".env is tracked by git; remove it with: git rm --cached .env"
    elif git check-ignore -q .env; then
      ok ".env is gitignored"
    else
      bad ".env is not gitignored; add .env to .gitignore"
    fi
  fi

  exit "$doctor_failed"
}

# A downloaded CLI lives at $HARNESS_HOME/vX.Y.Z/harness, so its folder names its version.
cmd_version() {
  local cli_dir version root pinned=""
  cli_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  version=${cli_dir##*/}
  if ! [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Not a downloaded release: ${BASH_SOURCE[0]}" >&2
    return 1
  fi
  if root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f "$root/.claude/HARNESS_VERSION" ]; then
    pinned=$(<"$root/.claude/HARNESS_VERSION")
  fi
  echo "$version"
  if [ -n "$pinned" ] && [ "$(printf '%s\n%s\n' "$pinned" "$version" | sort -V | head -1)" != "$version" ]; then
    echo "Repo pinned at $pinned; run harness upgrade to update it." >&2
  fi
}

main() {
  harness_command=${1:-}
  [ $# -gt 0 ] && shift
  case "$harness_command" in
    install) cmd_install ;;
    upgrade) cmd_upgrade ;;
    doctor) cmd_doctor "$@" ;;
    issue) cmd_issue "$@" ;;
    stats) cmd_stats "$@" ;;
    uninstall) cmd_uninstall ;;
    help | -h | --help) usage ;;
    -v | --version) cmd_version ;;
    "")
      usage >&2
      exit 1
      ;;
    *)
      echo "Unknown command: $harness_command" >&2
      usage >&2
      exit 1
      ;;
  esac
}

# Guarded so the bin/check-* scripts can source this file for HARNESS_FILES.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
