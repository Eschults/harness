#!/usr/bin/env bash
# Checks for a newer harness release and, on confirmation, pulls the
# updated harness files in from the `v1` tag. Safe to re-run: it's a
# no-op once you're on the latest release.
set -euo pipefail
cd "$(dirname "$0")/.."

for tool in curl jq; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "$tool not found; install it (e.g. apt-get install $tool, or brew install $tool) to run bin/harness-upgrade." >&2
    exit 1
  fi
done

src=${HARNESS_SRC:-https://raw.githubusercontent.com/Eschults/harness/v1}

current=$(cat .claude/HARNESS_VERSION 2>/dev/null || true)
if [ -z "$current" ]; then
  echo "No .claude/HARNESS_VERSION found; run bin/harness-install first." >&2
  exit 1
fi

# Fetched to a temp path and only moved into place once the user confirms
# the upgrade below: the script must download this to know whether there's
# anything to confirm, but checking for an upgrade must stay a true no-op
# (per the top-of-file comment) when there's nothing to pull in or the user
# declines, so nothing in the working tree changes before that point.
version_check_new=bin/lib/version-check.sh.new
trap 'rm -f "$version_check_new"' EXIT
curl -fsSL "$src/bin/lib/version-check.sh" -o "$version_check_new"
# shellcheck source=bin/lib/version-check.sh
source "$version_check_new"

latest=$(latest_harness_version)

if [ -z "$latest" ]; then
  echo "No release tag matching vX.Y.Z found at $(harness_tags_url)" >&2
  exit 1
fi

if [ "$current" = "$latest" ]; then
  echo "Already up to date: $current"
  exit 0
fi

compare="https://github.com/Eschults/harness/compare/$current...$latest"
echo "Upgrading $current -> $latest: $compare"
open "$compare" 2>/dev/null || xdg-open "$compare" 2>/dev/null || true

read -rp "Pull in $latest now? [y/N] " confirm
if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
  echo "Skipped. Re-run bin/harness-upgrade when you're ready."
  exit 0
fi

curl -fsSL "$src/bin/lib/fetch-files.sh" -o bin/lib/fetch-files.sh
# shellcheck source=bin/lib/fetch-files.sh
source bin/lib/fetch-files.sh
fetch_harness_files
mv "$version_check_new" bin/lib/version-check.sh

# Downloaded to a temp file and moved into place, never written to directly:
# this script is still running from bin/harness-upgrade, and overwriting that
# file in place mid-run corrupts the running process.
curl -fsSL "$src/bin/harness-upgrade" -o bin/harness-upgrade.new
chmod +x bin/harness-upgrade.new
mv bin/harness-upgrade.new bin/harness-upgrade

echo "Pulled in $latest. Review the diff and commit."
