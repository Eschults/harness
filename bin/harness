#!/usr/bin/env bash
# harness-launcher
# The harness command: runs the CLI version the current repo pins in
# .claude/HARNESS_VERSION, downloading each version once into $HARNESS_HOME.
# install and upgrade run the latest release, since both move a repo forward,
# and upgrade also replaces this launcher with the latest release's.
# --version prints the version it would run, since older CLIs don't know their own.
set -euo pipefail

HARNESS_DEFAULT_SRC=https://raw.githubusercontent.com/Eschults/harness/v1
# First release that ships a CLI; repos pinned older run the latest one, which offers to upgrade them.
HARNESS_FIRST_CLI_VERSION=v1.3.0
LAUNCHER_MARKER='# harness-launcher'

harness_base() {
  echo "${HARNESS_RAW_BASE:-${HARNESS_DEFAULT_SRC%/*}}"
}

harness_major() {
  echo "${HARNESS_DEFAULT_SRC##*/}"
}

harness_home() {
  echo "${HARNESS_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/harness}"
}

harness_tags_url() {
  echo "${HARNESS_TAGS_URL:-https://api.github.com/repos/Eschults/harness/tags}"
}

require_tools() {
  local tool
  for tool in "$@"; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "$tool not found; install it (e.g. apt-get install $tool, or brew install $tool) to run harness." >&2
      exit 1
    fi
  done
}

is_release_version() {
  [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

version_at_least() {
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$2" ]
}

latest_version() {
  require_tools curl jq
  local latest
  # grep matching nothing is fine; pipefail would otherwise abort with no message.
  if ! latest=$(curl -fsSL "$(harness_tags_url)" | jq -r '.[].name' | { grep -E "^$(harness_major)\.[0-9]+\.[0-9]+$" || true; } | sort -V | tail -1); then
    echo "Could not look up harness releases at $(harness_tags_url)" >&2
    exit 1
  fi
  if [ -z "$latest" ]; then
    echo "No $(harness_major).Y.Z release tag found at $(harness_tags_url)" >&2
    exit 1
  fi
  echo "$latest"
}

pinned_version() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -f "$root/.claude/HARNESS_VERSION" ] || return 1
  echo "$(<"$root/.claude/HARNESS_VERSION")"
}

newest_cached_version() {
  local newest
  newest=$(find "$(harness_home)" -mindepth 2 -maxdepth 2 -name harness -perm -u+x 2>/dev/null |
    awk -F/ '{ print $(NF - 1) }' | { grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true; } | sort -V | tail -1)
  [ -n "$newest" ] && echo "$newest"
}

ensure_cli() {
  local version=$1 cli tmp base
  cli="$(harness_home)/$version/harness"
  [ -x "$cli" ] && return 0
  require_tools curl
  base=$(harness_base)
  mkdir -p "${cli%/*}"
  tmp="$cli.download"
  if curl -fsSL "$base/$version/bin/harness-cli" -o "$tmp" 2>/dev/null; then
    :
  # v1.3.x shipped the full CLI as bin/harness, before this launcher took that path.
  elif curl -fsSL "$base/$version/bin/harness" -o "$tmp" 2>/dev/null && ! grep -qxF "$LAUNCHER_MARKER" "$tmp"; then
    :
  else
    rm -f "$tmp"
    echo "Could not download the harness CLI $version from $base/$version" >&2
    exit 1
  fi
  chmod +x "$tmp"
  mv "$tmp" "$cli"
}

launcher_path() {
  local source=${BASH_SOURCE[0]} dir=.
  [[ "$source" == */* ]] && dir=${source%/*}
  dir=$(cd "$dir" && pwd)
  echo "$dir/${source##*/}"
}

# Safe whatever the user answers next: the launcher never changes which CLI version a repo runs.
update_launcher() {
  local version=$1 self new
  self=$(launcher_path)
  new="$self.new"
  if [ -L "$self" ] || [ ! -w "${self%/*}" ]; then
    echo "Skipped updating the harness command: $self is a symlink or not writable." >&2
    return 0
  fi
  if ! curl -fsSL "$(harness_base)/$version/bin/harness" -o "$new" 2>/dev/null || ! grep -qxF "$LAUNCHER_MARKER" "$new"; then
    rm -f "$new"
    return 0
  fi
  if cmp -s "$new" "$self"; then
    rm -f "$new"
    return 0
  fi
  chmod +x "$new"
  # Same directory, so this is an atomic rename that never rewrites the file bash is reading.
  mv "$new" "$self"
  echo "Updated the harness command at $self."
}

main() {
  local version
  case "${1:-}" in
    install) version=$(latest_version) ;;
    upgrade)
      version=$(latest_version)
      update_launcher "$version"
      ;;
    *)
      if version=$(pinned_version); then
        if ! is_release_version "$version"; then
          echo ".claude/HARNESS_VERSION holds '$version', not a vX.Y.Z release; run harness install." >&2
          exit 1
        fi
        version_at_least "$version" "$HARNESS_FIRST_CLI_VERSION" || version=$(latest_version)
      elif ! version=$(newest_cached_version); then
        version=$(latest_version)
      fi
      ;;
  esac
  if [[ "${1:-}" == --version || "${1:-}" == -v ]]; then
    echo "harness $version"
    return 0
  fi
  ensure_cli "$version"
  HARNESS_SRC="${HARNESS_SRC:-$(harness_base)/$version}" exec "$(harness_home)/$version/harness" "$@"
}

main "$@"
