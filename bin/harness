#!/usr/bin/env bash
# harness-launcher
# The harness command: runs the CLI version the current repo pins in
# .claude/HARNESS_VERSION, downloading each version once into $HARNESS_HOME.
# install and versions never touch a repo or exec into a cached CLI: they
# only manage that $HARNESS_HOME cache directly, here in the launcher. use
# runs the latest release, since it moves a repo forward or back, and also
# replaces this launcher with the latest release's.
# --version prints the version it would run, since older CLIs don't know their own.
set -euo pipefail

HARNESS_DEFAULT_SRC=https://raw.githubusercontent.com/Eschults/harness/v1
# First release that ships a CLI; repos pinned older run the latest one, which offers to upgrade them.
HARNESS_FIRST_CLI_VERSION=v1.3.0
LAUNCHER_MARKER='# harness-launcher'

harness_base() {
  echo "${HARNESS_RAW_BASE:-${HARNESS_DEFAULT_SRC%/*}}"
}

harness_major() {
  echo "${HARNESS_DEFAULT_SRC##*/}"
}

harness_home() {
  echo "${HARNESS_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/harness}"
}

harness_tags_url() {
  echo "${HARNESS_TAGS_URL:-https://api.github.com/repos/Eschults/harness/tags}"
}

require_tools() {
  local tool
  for tool in "$@"; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "$tool not found; install it (e.g. apt-get install $tool, or brew install $tool) to run harness." >&2
      exit 1
    fi
  done
}

is_release_version() {
  [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

version_at_least() {
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$2" ]
}

latest_version() {
  require_tools curl jq
  local latest
  # grep matching nothing is fine; pipefail would otherwise abort with no message.
  if ! latest=$(curl -fsSL "$(harness_tags_url)" | jq -r '.[].name' | { grep -E "^$(harness_major)\.[0-9]+\.[0-9]+$" || true; } | sort -V | tail -1); then
    echo "Could not look up harness releases at $(harness_tags_url)" >&2
    exit 1
  fi
  if [ -z "$latest" ]; then
    echo "No $(harness_major).Y.Z release tag found at $(harness_tags_url)" >&2
    exit 1
  fi
  echo "$latest"
}

pinned_version() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -f "$root/.claude/HARNESS_VERSION" ] || return 1
  echo "$(<"$root/.claude/HARNESS_VERSION")"
}

# Never fails, even under pipefail: find exits non-zero (with its own
# stderr noise suppressed above) when $HARNESS_HOME doesn't exist yet, a
# normal "nothing cached" state, not an error worth aborting an unguarded
# caller like cmd_versions' own `cached=$(cached_versions | sort -rV)`.
cached_versions() {
  find "$(harness_home)" -mindepth 2 -maxdepth 2 -name harness -perm -u+x 2>/dev/null |
    awk -F/ '{ print $(NF - 1) }' | { grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true; } | sort -V || true
}

newest_cached_version() {
  local newest
  newest=$(cached_versions | tail -1)
  [ -n "$newest" ] && echo "$newest"
}

# Validates a bare or v-prefixed user-typed version ($1) against this CLI's
# own major, returning the internal vX.Y.Z tag form on stdout. Exits 1,
# naming the original input, on a bad shape or the wrong major; never hits
# the network, since install/use/versions commands check existence their
# own way (a real fetch for install/use, the cache listing for versions).
to_release_tag() {
  local input=$1 tag major major_bare
  major=$(harness_major)
  major_bare=${major#v}
  tag="v${input#v}"
  if ! [[ "$tag" =~ ^${major}\.[0-9]+\.[0-9]+$ ]]; then
    echo "$input is not a $major_bare.Y.Z version" >&2
    exit 1
  fi
  echo "$tag"
}

ensure_cli() {
  local version=$1 cli tmp base
  cli="$(harness_home)/$version/harness"
  [ -x "$cli" ] && return 0
  require_tools curl
  base=$(harness_base)
  mkdir -p "${cli%/*}"
  tmp="$cli.download"
  if curl -fsSL "$base/$version/bin/harness-cli" -o "$tmp" 2>/dev/null; then
    :
  # v1.3.x shipped the full CLI as bin/harness, before this launcher took that path.
  elif curl -fsSL "$base/$version/bin/harness" -o "$tmp" 2>/dev/null && ! grep -qxF "$LAUNCHER_MARKER" "$tmp"; then
    :
  else
    rm -f "$tmp"
    echo "Could not download the harness CLI $version from $base/$version" >&2
    exit 1
  fi
  chmod +x "$tmp"
  mv "$tmp" "$cli"
}

launcher_path() {
  local source=${BASH_SOURCE[0]} dir=.
  [[ "$source" == */* ]] && dir=${source%/*}
  dir=$(cd "$dir" && pwd)
  echo "$dir/${source##*/}"
}

# Safe whatever the user answers next: the launcher never changes which CLI version a repo runs.
update_launcher() {
  local version=$1 self new
  self=$(launcher_path)
  new="$self.new"
  if [ -L "$self" ] || [ ! -w "${self%/*}" ]; then
    echo "Skipped updating the harness command: $self is a symlink or not writable." >&2
    return 0
  fi
  if ! curl -fsSL "$(harness_base)/$version/bin/harness" -o "$new" 2>/dev/null || ! grep -qxF "$LAUNCHER_MARKER" "$new"; then
    rm -f "$new"
    return 0
  fi
  if cmp -s "$new" "$self"; then
    rm -f "$new"
    return 0
  fi
  chmod +x "$new"
  # Same directory, so this is an atomic rename that never rewrites the file bash is reading.
  mv "$new" "$self"
  echo "Updated the harness command at $self."
}

version_line() {
  local version=$1 pinned=$2
  echo "$version"
  if [ -n "$pinned" ] && ! version_at_least "$pinned" "$version"; then
    echo "Repo pinned at $pinned; run harness use to update it." >&2
  fi
}

# `harness install [<version>]`: a pure $HARNESS_HOME cache operation, never
# touching a repo and never exec'ing into any cached CLI. With no argument,
# caches the latest release; existence of an explicit version is checked by
# the real fetch inside ensure_cli, not a separate tags lookup.
cmd_install_version() {
  local requested=$1 version
  if [ -n "$requested" ]; then
    version=$(to_release_tag "$requested")
  else
    version=$(latest_version)
  fi
  ensure_cli "$version"
  echo "Installed ${version#v} into the harness CLI cache ($(harness_home)/$version)."
}

# `harness versions`: lists every version cached in $HARNESS_HOME, newest
# first, marking the one this repo is pinned to (if any) as current. Never
# touches the network.
cmd_versions() {
  local cached pinned v
  cached=$(cached_versions | sort -rV)
  if [ -z "$cached" ]; then
    echo "No harness CLI versions cached yet; run harness install to fetch one."
    return 0
  fi
  pinned=$(pinned_version 2>/dev/null || true)
  while IFS= read -r v; do
    if [ -n "$pinned" ] && [ "$v" = "$pinned" ]; then
      echo "* ${v#v} (current)"
    else
      echo "  ${v#v}"
    fi
  done <<< "$cached"
}

main() {
  local version pinned=""
  case "${1:-}" in
    install)
      if [ $# -gt 2 ]; then
        echo "Usage: harness install [<version>]" >&2
        exit 1
      fi
      cmd_install_version "${2:-}"
      return 0
      ;;
    versions)
      if [ $# -gt 1 ]; then
        echo "Usage: harness versions" >&2
        exit 1
      fi
      cmd_versions
      return 0
      ;;
    use | upgrade)
      version=$(latest_version)
      update_launcher "$version"
      ;;
    *)
      if version=$(pinned_version); then
        pinned=$version
        if ! is_release_version "$version"; then
          echo ".claude/HARNESS_VERSION holds '$version', not a vX.Y.Z release; run harness use." >&2
          exit 1
        fi
        version_at_least "$version" "$HARNESS_FIRST_CLI_VERSION" || version=$(latest_version)
      elif ! version=$(newest_cached_version); then
        version=$(latest_version)
      fi
      ;;
  esac
  if [[ "${1:-}" == --version || "${1:-}" == -v ]]; then
    version_line "$version" "$pinned"
    return 0
  fi
  ensure_cli "$version"
  # The cached CLI's own harness_release_src() reads HARNESS_RELEASE_SRC as
  # a base it appends a version to itself (for `use`'s own target, which
  # may differ from $version here, or for doctor's drift check), so this
  # propagates harness_base() itself, not harness_base()/$version.
  HARNESS_RELEASE_SRC="${HARNESS_RELEASE_SRC:-$(harness_base)}" exec "$(harness_home)/$version/harness" "$@"
}

main "$@"
