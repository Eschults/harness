#!/usr/bin/env bash
# Functional round trip for `harness upgrade` against fake fixtures, never
# this repo's real tags or raw content. bin/harness always runs upgrade with
# the latest release's CLI, so this primes a repo with the old fixture's CLI
# and upgrades it with the new one's. No model calls.
set -euo pipefail
cd "$(dirname "$0")/.."

# shellcheck source=bin/lib/check-helpers.sh
source bin/lib/check-helpers.sh
# shellcheck source=bin/harness-cli
source bin/harness-cli

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

old_src="$scratch/old_src"
new_src="$scratch/new_src"
tags_json="$scratch/tags.json"
repo="$scratch/repo"

build_fixture() {
  local dir=$1 version=$2
  mkdir -p "$dir/bin"
  cp bin/harness-cli "$dir/bin/harness-cli"
  chmod +x "$dir/bin/harness-cli"
  for f in "${HARNESS_FILES[@]}"; do
    mkdir -p "$dir/$(dirname "$f")"
    cp "$f" "$dir/$f"
  done
  echo "$version" > "$dir/.claude/HARNESS_VERSION"
}

build_fixture "$old_src" "v1.0.1"
build_fixture "$new_src" "v1.9.9"
printf '\n<!-- check-harness-upgrade fixture marker: v1.9.9 -->\n' >> "$new_src/.claude/harness-rules.md"

# A file only the newer release's CLI names, to prove upgrade fetches with that CLI's list.
extra_file=".claude/new-fixture-file.txt"
mkdir -p "$new_src/$(dirname "$extra_file")"
echo "added in v1.9.9" > "$new_src/$extra_file"
awk -v extra="$extra_file" '
  index($0, "\".claude/HARNESS_VERSION\"") { print "  \"" extra "\"" }
  { print }
' bin/harness-cli > "$new_src/bin/harness-cli"

# v2.0.0 is a newer major, which this v1 CLI must ignore rather than offer.
printf '[{"name":"v1.0.1"},{"name":"v1.9.9"},{"name":"v2.0.0"}]' > "$tags_json"

bad_tags_json="$scratch/bad-tags.json"
printf '[{"name":"latest"},{"name":"vNext"}]' > "$bad_tags_json"

git init -q "$repo"
mkdir -p "$repo/src/nested"

poison_network

stub_url_openers "$scratch/stub_bin"

# Runs from a nested directory, so the CLI must find the repo root itself.
run_upgrade() {
  local answer=${3:-y}
  (
    cd "$repo/src/nested" || exit 1
    export HARNESS_SRC="$1" HARNESS_TAGS_URL="$2"
    printf '%s\n' "$answer" | "$new_src/bin/harness-cli" upgrade
  )
}

snapshot() {
  find "$repo" -path "$repo/.git" -prune -o -type f -print0 | sort -z | xargs -0 sha256sum
}

if ! output=$(cd "$repo" && HARNESS_SRC="file://$old_src" "$old_src/bin/harness-cli" install 2>&1); then
  echo "$output" >&2
  fail "harness install failed priming the scratch repo at the old fixture release"
fi
[ "$(cat "$repo/.claude/HARNESS_VERSION")" = "v1.0.1" ] || fail "expected the primed repo to start at v1.0.1"
grep -q "check-harness-upgrade fixture marker" "$repo/.claude/harness-rules.md" && fail "expected the primed repo to not yet carry the newer fixture's marker"

before=$(snapshot)
if ! output=$(run_upgrade "file://$new_src" "file://$tags_json" n 2>&1); then
  echo "$output" >&2
  fail "harness upgrade failed when the user declined"
fi
echo "$output" | grep -q "Skipped" || fail "expected a declined upgrade to say it skipped, got: $output"
after=$(snapshot)
[ "$before" = "$after" ] || fail "expected a declined upgrade to leave every file untouched"
echo "✓ a declined upgrade left every file untouched"

if ! output=$(run_upgrade "file://$new_src" "file://$tags_json" 2>&1); then
  echo "$output" >&2
  fail "harness upgrade failed pulling in the fake newer release; check it honors \$HARNESS_TAGS_URL instead of hitting the real GitHub API"
fi
echo "$output" | grep -qF "Upgrading v1.0.1 -> v1.9.9: https://github.com/Eschults/harness/releases/tag/v1.9.9" || fail "expected upgrade to report the v1.0.1 -> v1.9.9 transition with v1.9.9's release notes, got: $output"

[ "$(cat "$repo/.claude/HARNESS_VERSION")" = "v1.9.9" ] || fail "expected .claude/HARNESS_VERSION to read v1.9.9 after upgrading, got $(cat "$repo/.claude/HARNESS_VERSION" 2>/dev/null)"
echo "✓ upgrade bumped .claude/HARNESS_VERSION to the new tag"

for f in "${HARNESS_FILES[@]}" "$extra_file"; do
  cmp -s "$repo/$f" "$new_src/$f" || fail "expected $f to match the fake newer release's content after upgrading"
done
grep -q "check-harness-upgrade fixture marker" "$repo/.claude/harness-rules.md" || fail "expected the newer fixture's marker to show up after upgrading"
echo "✓ upgrade pulled every harness file's newer content"
echo "✓ upgrade fetched $extra_file, which only the newer release's CLI named"

echo "$output" | grep -q "v2.0.0" && fail "expected the v1 CLI to ignore the v2.0.0 tag, got: $output"
echo "✓ upgrade ignored a tag from a newer major"

before=$(snapshot)
if ! output=$(run_upgrade "file://$new_src" "file://$tags_json" 2>&1); then
  echo "$output" >&2
  fail "harness upgrade failed re-running against a repo already on the latest fake release"
fi
echo "$output" | grep -q "Already up to date: v1.9.9" || fail "expected a no-op re-run to report already up to date, got: $output"
after=$(snapshot)
[ "$before" = "$after" ] || fail "expected re-running harness upgrade on an up-to-date repo to leave every file untouched"
echo "✓ re-running upgrade on an up-to-date repo left every file untouched"

before=$(snapshot)
if output=$(run_upgrade "file://$new_src" "file://$bad_tags_json" 2>&1); then
  fail "expected harness upgrade to fail when no tag at \$HARNESS_TAGS_URL matches vX.Y.Z, got: $output"
fi
echo "$output" | grep -q "No v1.Y.Z release tag found" || fail "expected a clear error when no tag matches v1.Y.Z, got: $output"
after=$(snapshot)
[ "$before" = "$after" ] || fail "expected a failed tag lookup to leave every file untouched"
echo "✓ a tags response with no matching vX.Y.Z tag fails clearly and touches nothing"

# A PATH with curl but not jq: the prerequisite check must fire before the
# first network call (and the "y" below never gets read), naming jq and how
# to install it, and touching nothing.
no_jq_bin="$scratch/no_jq_bin"
mkdir -p "$no_jq_bin"
for cmd in bash curl; do
  cmd_path=$(command -v "$cmd") || continue
  ln -sf "$cmd_path" "$no_jq_bin/$cmd"
done

before=$(snapshot)
if output=$(cd "$repo" && PATH="$no_jq_bin" "$new_src/bin/harness-cli" upgrade 2>&1); then
  fail "expected harness upgrade to fail when jq is missing from PATH"
fi
echo "$output" | grep -q "jq not found; install it" || fail "expected a one-line error naming jq and how to install it, got: $output"
after=$(snapshot)
[ "$before" = "$after" ] || fail "expected a missing jq to leave every file untouched"
echo "✓ a PATH without jq fails fast, before any network call, and touches nothing"

# A v1.3.x CLI replaces itself with bin/harness after the user confirms, then
# hands off with HARNESS_UPGRADE_CONFIRMED=1; the prompt's "y" is already
# consumed, so the handed-off upgrade must install without asking again.
handoff_repo="$scratch/handoff-repo"
git init -q "$handoff_repo"
(cd "$handoff_repo" && HARNESS_SRC="file://$old_src" "$old_src/bin/harness-cli" install >/dev/null)
if ! output=$(cd "$handoff_repo" && HARNESS_SRC="file://$new_src" HARNESS_UPGRADE_CONFIRMED=1 "$new_src/bin/harness-cli" upgrade </dev/null 2>&1); then
  echo "$output" >&2
  fail "expected a handed-off upgrade to install without prompting"
fi
[ "$(cat "$handoff_repo/.claude/HARNESS_VERSION")" = "v1.9.9" ] || fail "expected the handed-off upgrade to pull in v1.9.9"
echo "✓ an upgrade handed off by a v1.3.x CLI installs without asking again"

echo
echo "harness-upgrade round trip: all passed"
