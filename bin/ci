#!/usr/bin/env bash
# Zero-cost regression checks on this repo's own rules text (harness-rules.md,
# CLAUDE.md, and the issue-to-pr / next-to-build prompts), plus shellcheck
# over the bin/ scripts every adopter curls and runs unreviewed.
# No model calls.
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v shellcheck >/dev/null; then
  echo "shellcheck not found; install it (https://github.com/koalaman/shellcheck#installing) to run bin/ci locally." >&2
  exit 1
fi

echo "Running shellcheck ($(shellcheck --version | grep ^version:))"
shellcheck_failed=0
for f in bin/ci bin/harness-install bin/harness-upgrade bin/harness-uninstall bin/harness-doctor bin/release bin/lib/fetch-files.sh bin/lib/check-helpers.sh bin/check-install-uninstall bin/check-harness-upgrade bin/check-claude-workflow bin/check-release bin/check-doctor; do
  if shellcheck_output=$(shellcheck -x "$f" 2>&1); then
    echo "✓ shellcheck: $f"
  else
    echo "✗ shellcheck: $f"
    echo "$shellcheck_output"
    shellcheck_failed=1
  fi
done
[ "$shellcheck_failed" -eq 0 ] || exit 1
echo

echo "Running the install/uninstall round trip"
if ./bin/check-install-uninstall; then
  round_trip_failed=0
else
  round_trip_failed=1
fi
echo

echo "Running the harness-upgrade round trip"
if ./bin/check-harness-upgrade; then
  upgrade_round_trip_failed=0
else
  upgrade_round_trip_failed=1
fi
echo

echo "Running the claude.yml fire step check"
if ./bin/check-claude-workflow; then
  claude_workflow_failed=0
else
  claude_workflow_failed=1
fi
echo

echo "Running the release round trip"
if ./bin/check-release; then
  release_failed=0
else
  release_failed=1
fi
echo

echo "Running the harness-doctor check"
if ./bin/check-doctor; then
  doctor_failed=0
else
  doctor_failed=1
fi
echo

if ./bin/check-rules; then
  rules_failed=0
else
  rules_failed=1
fi

failed_suites=()
[ "$round_trip_failed" -eq 0 ] || failed_suites+=("install/uninstall round trip")
[ "$upgrade_round_trip_failed" -eq 0 ] || failed_suites+=("harness-upgrade round trip")
[ "$claude_workflow_failed" -eq 0 ] || failed_suites+=("claude.yml fire step check")
[ "$release_failed" -eq 0 ] || failed_suites+=("release round trip")
[ "$doctor_failed" -eq 0 ] || failed_suites+=("harness-doctor check")
[ "$rules_failed" -eq 0 ] || failed_suites+=("rules check")

echo
if [ "${#failed_suites[@]}" -gt 0 ]; then
  failed_list=$(printf '%s, ' "${failed_suites[@]}")
  echo "bin/ci FAILED (scroll up for ✗): ${failed_list%, }" >&2
  exit 1
fi
echo "bin/ci: all suites passed"
