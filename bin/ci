#!/usr/bin/env bash
# Zero-cost regression checks on this repo's own rules (.claude/harness-rules.md, CLAUDE.md).
# No model calls.
#
# Model-based evals (claude plugin eval) are added under evals/ only as regression tests for
# real, high-severity bugs, and are run manually — not part of this default path.
set -euo pipefail
cd "$(dirname "$0")/.."

exec ./bin/check-rules
