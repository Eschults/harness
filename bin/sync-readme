#!/usr/bin/env python3
"""Regenerates README.md's Guardrails list from .claude/harness-rules.md. Run it after editing the rules."""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "lib"))
from readme_guardrails import ROOT, RULES_PATH, synced_readme  # noqa: E402

readme_path = ROOT / "README.md"
readme = readme_path.read_text()
updated = synced_readme(readme, (ROOT / RULES_PATH).read_text())
if updated == readme:
    print("README.md Guardrails already match .claude/harness-rules.md")
else:
    readme_path.write_text(updated)
    print("README.md Guardrails regenerated from .claude/harness-rules.md; review and commit the diff")
