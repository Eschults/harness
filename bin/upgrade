#!/usr/bin/env bash
# Checks for a newer harness release and, on confirmation, pulls the
# updated harness files in from the `v1` tag. Safe to re-run: it's a
# no-op once you're on the latest release.
set -euo pipefail
cd "$(dirname "$0")/.."

current=$(cat .claude/HARNESS_VERSION 2>/dev/null || true)
if [ -z "$current" ]; then
  echo "No .claude/HARNESS_VERSION found; run the harness setup first." >&2
  exit 1
fi

latest=$(curl -fsSL https://api.github.com/repos/Eschults/harness/tags | jq -r '.[].name' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)

if [ "$current" = "$latest" ]; then
  echo "Already up to date: $current"
  exit 0
fi

compare="https://github.com/Eschults/harness/compare/$current...$latest"
echo "Upgrading $current -> $latest: $compare"
open "$compare" 2>/dev/null || xdg-open "$compare" 2>/dev/null || true

read -rp "Pull in $latest now? [y/N] " confirm
if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
  echo "Skipped. Re-run bin/upgrade when you're ready."
  exit 0
fi

src=https://raw.githubusercontent.com/Eschults/harness/v1
curl -fsSL "$src/.github/workflows/claude.yml" -o .github/workflows/claude.yml
curl -fsSL "$src/.claude/prompts/issue-to-pr.md" -o .claude/prompts/issue-to-pr.md
curl -fsSL "$src/.claude/prompts/next-to-build.md" -o .claude/prompts/next-to-build.md
curl -fsSL "$src/.claude/harness-rules.md" -o .claude/harness-rules.md
curl -fsSL "$src/.claude/HARNESS_VERSION" -o .claude/HARNESS_VERSION

# Downloaded to a temp file and moved into place, never written to directly:
# this script is still running from bin/upgrade, and overwriting that file
# in place mid-run corrupts the running process.
curl -fsSL "$src/bin/upgrade" -o bin/upgrade.new
chmod +x bin/upgrade.new
mv bin/upgrade.new bin/upgrade

echo "Pulled in $latest. Review the diff and commit."
